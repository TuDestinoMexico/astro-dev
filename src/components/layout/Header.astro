---
import MenuBar from "../ui/MenuBar.astro";
import SubMenu from "../ui/SubMenu.astro";
import ClientLoginButton from "../ui/ClientLoginButton.jsx";

// IMPORTACIÓN DE FIREBASE: Ajusta la ruta de importación de tu db si es necesario
import { db } from "../../lib/firebase";
import { doc, getDoc } from "firebase/firestore";

// 1. backup por si falla firebase
let logoUrl = "https://storage.googleapis.com/tudestinomx_bucket/assets/test/tdmx_logo_mundial.png";
let whatsappGlobal = "529987141365";

try {
    const configDocRef = doc(db, "config", "general");

    // Creamos una promesa que se cancela automáticamente a los 2.5 segundos
    const timeoutPromise: Promise<never> = new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Timeout de red")), 2500)
    );

    // Corremos una carrera: lo que pase primero (leer Firebase o llegar a 2.5s)
    const docSnap = await Promise.race([
        getDoc(configDocRef),
        timeoutPromise
    ]);

    if (docSnap && docSnap.exists()) {
        const configData = docSnap.data();
        if (configData.logoUrl) {
            logoUrl = configData.logoUrl;
        }
        if (configData.whatsappGlobal) {
            whatsappGlobal = configData.whatsappGlobal;
        }
    }
} catch (error) {
    // Al atrapar el fallo aquí, tu consola limpia el log y la web carga rápido
    console.warn("[Header.astro] Firestore lento o no disponible. Usando logo de respaldo seguro.");
}
---
<div>
    <div class="container mx-auto flex flex-col xl:flex-row justify-between items-center">
        <div class="h-full flex items-center xl:justify-start justify-center mt-5 xl:mt-0">
            <a href="/" class="block w-70 aspect-[4/1] shrink-0">
                {/* VERSIÓN 1: Logo de la cabecera principal con ancho w-70 */}
                <img
                        class="w-full h-full object-contain"
                        src={logoUrl}
                        alt="Tu Destino Mexico"
                        width="280"
                        height="70"
                        loading="eager"
                        decoding="async"
                >
            </a>
        </div>
        <div class="xl:flex h-auto flex-row font-bold rounded-bl-xl overflow-hidden justify-end items-stretch hidden shadow-lg">
            <MenuBar title="Solo ventas" subtitle="(998) 980 6611" url="tel:529989806611" color="bg-green-400" icon="fa7-solid:phone" />
            <MenuBar
                    title="WhatsApp"
                    subtitle={`(${whatsappGlobal.slice(2, 5)}) ${whatsappGlobal.slice(5, 8)} ${whatsappGlobal.slice(8)}`}
                    url={`https://wa.me/${whatsappGlobal}`}
                    color="bg-green-600"
                    icon="simple-icons:whatsapp"
            />
            <MenuBar title="Pagar en linea" subtitle="lo hacemos facil" url="/pagos" color="bg-lime-500" icon="fa7-solid:credit-card" />
            <MenuBar title="Quienes Somos" subtitle="La familia Xolo" url="/nosotros" color="bg-orange-500" icon="fa7-solid:people-group" />
            <ClientLoginButton client:only="react" />
        </div>

        <div id="mobile-topbar-menu" class="xl:hidden w-full p-3 mt-3 shadow-lg">
            <div class="flex items-stretch gap-2">
                <button
                    id="hamburger-btn"
                    class="bg-slate-800 text-white p-3 rounded-xl flex items-center justify-center shrink-0 transition-all duration-300 hover:brightness-110 cursor-pointer"
                    aria-label="Menú"
                    aria-expanded="false"
                >
                    <span id="hamburger-icon" class="material-icons-outlined text-white pointer-events-none">menu</span>
                </button>
                <ClientLoginButton client:only="react" />
            </div>

            <div id="mobile-menu-panel" class="grid grid-cols-1 min-[400px]:grid-cols-2 gap-2 mt-3 overflow-hidden opacity-0 -translate-y-2 pointer-events-none invisible h-0 transition-all duration-300 ease-out">
                <MenuBar title="Solo ventas" subtitle="(998) 980 6611" url="tel:529989806611" color="bg-green-400" icon="fa7-solid:phone" />
                <MenuBar
                        title="WhatsApp"
                        subtitle={`(${whatsappGlobal.slice(2, 5)}) ${whatsappGlobal.slice(5, 8)} ${whatsappGlobal.slice(8)}`}
                        url={`https://wa.me/${whatsappGlobal}`}
                        color="bg-green-600"
                        icon="simple-icons:whatsapp"
                />
                <MenuBar title="Pagar en linea" subtitle="lo hacemos facil" url="/pagos" color="bg-lime-500" icon="fa7-solid:credit-card" />
                <MenuBar title="Quienes Somos" subtitle="La familia Xolo" url="/nosotros" color="bg-orange-500" icon="fa7-solid:people-group" />
            </div>
        </div>
    </div>

    <div id="sticky-header-container" class="relative">
        <nav id="main-nav" class="relative w-full z-100 transition-all duration-300">
            <div id="nav-bg" class="absolute inset-0 bg-transparent transition-all duration-300"></div>

            <div class="container mx-auto px-5 relative">
                <div
                        id="nav-content"
                        class="flex flex-row items-center justify-center py-4 transition-all duration-300 gap-5"
                >
                    <a
                            href="/"
                            id="logo-scroll"
                            class="w-0 aspect-[4/1] opacity-0 overflow-hidden transition-all duration-300 ease-in-out shrink-0 pointer-events-none"
                    >
                        {/* VERSIÓN 2: Logo adaptado para el scroll pegajoso (Sticky Nav) */}
                        <img
                                class="w-full h-full object-contain"
                                src={logoUrl}
                                alt="Tu Destino Mexico"
                                width="192"
                                height="48"
                        />
                    </a>

                    <div class="relative flex items-center grow md:grow-0 overflow-hidden">
                        <button id="prev-btn" class="absolute left-0 z-10 bg-white/80 p-1 rounded-full shadow-md md:hidden opacity-0 transition-opacity">
                            <span class="material-icons-outlined text-purple-800 pointer-events-none">chevron_left</span>
                        </button>

                        <div id="submenu-container" class="flex flex-row gap-6 text-md xl:text-lg font-bold overflow-x-auto no-scrollbar py-2 flex-grow md:justify-center scroll-smooth">
                            <SubMenu title="Hoteles" icon="balcony" url="/hoteles" />
                            <SubMenu title="Tours" icon="tour" url="/tours" />
                            <SubMenu title="Destinos" icon="public" url="/destinos" />
                            <SubMenu title="Convenios" icon="handshake" url="/convenios" />
                            <SubMenu title="Quienes somos" icon="people" url="/nosotros" mobileOnly={true} />
                            <SubMenu title="XoloRuta" icon="place" url="/xolo-ruta" />
                            <SubMenu title="Recomendaciones" icon="star" url="/recomendaciones" />
                            <div class="w-10 md:hidden shrink-0"></div>
                        </div>

                        <button id="next-btn" class="absolute right-0 z-10 bg-white/80 p-1 rounded-full shadow-md md:hidden transition-opacity">
                            <span class="material-icons-outlined text-purple-800 pointer-events-none">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <div id="nav-spacer" class="h-0 transition-all duration-300"></div>
    </div>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    #nav-content, #nav-bg, #logo-scroll, #nav-spacer {
        will-change: transform, opacity, width, padding, height;
    }
</style>

<script>
    const nav = document.getElementById('main-nav');
    const navBg = document.getElementById('nav-bg');
    const navContent = document.getElementById('nav-content');
    const logoScroll = document.getElementById('logo-scroll');
    const spacer = document.getElementById('nav-spacer');

    const container = document.getElementById('submenu-container');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    window.addEventListener('scroll', () => {
        const isScrolled = window.scrollY > 150;

        if (isScrolled) {
            nav?.classList.add('fixed', 'top-0', 'left-0', 'shadow-lg');
            nav?.classList.remove('relative');
            navBg?.classList.replace('bg-transparent', 'bg-white');
            spacer?.classList.add('h-[88px]');
            navContent?.classList.replace('justify-center', 'justify-between');
            logoScroll?.classList.remove('w-0', 'opacity-0', 'pointer-events-none');
            logoScroll?.classList.add('w-48', 'opacity-100');
            navContent?.classList.replace('py-4', 'py-2');
        } else {
            nav?.classList.remove('fixed', 'top-0', 'left-0', 'shadow-lg');
            nav?.classList.add('relative');
            navBg?.classList.replace('bg-white', 'bg-transparent');
            spacer?.classList.remove('h-[88px]');
            navContent?.classList.replace('justify-between', 'justify-center');
            logoScroll?.classList.add('w-0', 'opacity-0', 'pointer-events-none');
            logoScroll?.classList.remove('w-48', 'opacity-100');
            navContent?.classList.replace('py-2', 'py-4');
        }
    });

    nextBtn?.addEventListener('click', () => container?.scrollBy({ left: 150, behavior: 'smooth' }));
    prevBtn?.addEventListener('click', () => container?.scrollBy({ left: -150, behavior: 'smooth' }));

    container?.addEventListener('scroll', () => {
        if (!container || !prevBtn || !nextBtn) return;
        prevBtn.style.opacity = container.scrollLeft > 10 ? "1" : "0";
        const maxScroll = container.scrollWidth - container.clientWidth;
        nextBtn.style.opacity = container.scrollLeft >= maxScroll - 10 ? "0" : "1";
    });

    const hamburgerBtn = document.getElementById('hamburger-btn');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const mobilePanel = document.getElementById('mobile-menu-panel');
    const mobileMenuRoot = document.getElementById('mobile-topbar-menu');

    const closeMobileMenu = () => {
        if (!mobilePanel || !hamburgerBtn || !hamburgerIcon) return;
        mobilePanel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none', 'invisible', 'h-0');
        mobilePanel.classList.remove('opacity-100', 'translate-y-0', 'visible');
        hamburgerIcon.textContent = 'menu';
        hamburgerBtn.setAttribute('aria-expanded', 'false');
    };

    const openMobileMenu = () => {
        if (!mobilePanel || !hamburgerBtn || !hamburgerIcon) return;
        mobilePanel.classList.add('opacity-100', 'translate-y-0', 'visible');
        mobilePanel.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none', 'invisible', 'h-0');
        hamburgerIcon.textContent = 'close';
        hamburgerBtn.setAttribute('aria-expanded', 'true');
    };

    hamburgerBtn?.addEventListener('click', () => {
        const isOpen = mobilePanel?.classList.contains('opacity-100');
        if (isOpen) {
            closeMobileMenu();
        } else {
            openMobileMenu();
        }
    });

    mobilePanel?.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) {
            closeMobileMenu();
        }
    });

    document.addEventListener('mousedown', (e) => {
        if (mobileMenuRoot && e.target instanceof Node && !mobileMenuRoot.contains(e.target)) {
            closeMobileMenu();
        }
    });
</script>
