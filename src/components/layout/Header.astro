---
import ClientLoginButton from "../ui/ClientLoginButton.jsx";
import { Icon } from "astro-icon/components";

import { getGeneralConfig } from "../../lib/generalConfig";

const { logoUrl, whatsappGlobal } = await getGeneralConfig();

const VENTAS_TEL = "529989806611";
const ventasTelHref = `tel:+${VENTAS_TEL}`;
const ventasTelLabel = `(${VENTAS_TEL.slice(2, 5)}) ${VENTAS_TEL.slice(5, 8)} ${VENTAS_TEL.slice(8)}`;
// Acción principal: cotizar por WhatsApp con un mensaje inicial, sin datos personales.
const cotizarHref = `https://wa.me/${whatsappGlobal}?text=${encodeURIComponent("Hola, quiero cotizar un viaje.")}`;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (url: string) => pathname === url || pathname.startsWith(`${url}/`);

// Navegación principal con ícono y texto (escritorio).
const primaryLinks = [
    { title: "Hoteles", icon: "building-2", url: "/hoteles" },
    { title: "Tours", icon: "map", url: "/tours" },
    { title: "Destinos", icon: "globe-2", url: "/destinos" },
];

// Secundarios: viven en el menú hamburguesa.
const menuLinks = [
    { title: "Convenios", icon: "handshake", url: "/convenios" },
    { title: "Quiénes somos", icon: "users", url: "/nosotros" },
    { title: "Reseñas", icon: "star", url: "/recomendaciones" },
];

// En móvil, Destinos no está en la barra inferior, así que entra al menú.
const mobileMenuLinks = [{ title: "Destinos", icon: "globe-2", url: "/destinos" }, ...menuLinks];

const tabItems = [
    { title: "Inicio", icon: "house", url: "/" },
    { title: "Hoteles", icon: "building-2", url: "/hoteles" },
    { title: "Tours", icon: "map", url: "/tours" },
    { title: "Cuenta", icon: "user-round", url: "/cliente/dashboard" },
];

const iconButtonClass = "flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 transition hover:border-purple-800 hover:text-purple-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60";
const pillOutlineClass = "inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-purple-800 hover:text-purple-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60";
---

<!-- ESCRITORIO: navegación con ícono y acciones a la derecha -->
<header class="relative hidden border-b border-slate-100 bg-white xl:block">
    <div class="container mx-auto flex h-20 items-center gap-6 px-5">
        <a href="/" class="shrink-0" aria-label="Tu Destino México, inicio">
            <img class="h-10 w-auto object-contain" src={logoUrl} alt="Tu Destino México" width="200" height="50" decoding="async">
        </a>

        <nav aria-label="Principal" class="flex flex-1 items-center justify-center gap-7 whitespace-nowrap text-sm font-bold">
            {primaryLinks.map(({ title, icon, url }) => (
                <a
                    href={url}
                    aria-current={isActive(url) ? "page" : undefined}
                    class:list={[
                        "inline-flex items-center gap-2 rounded-md py-1 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60",
                        isActive(url) ? "text-purple-800 border-b-2 border-purple-800" : "text-slate-600 hover:text-purple-800",
                    ]}
                >
                    <Icon name={`lucide:${icon}`} class="h-5 w-5" aria-hidden="true" />
                    {title}
                </a>
            ))}
        </nav>

        <div class="flex shrink-0 items-center gap-3">
            <a href="/pagos" class={pillOutlineClass}>
                <Icon name="lucide:credit-card" class="h-4 w-4" aria-hidden="true" />
                Pagar en línea
            </a>
            <a
                href={cotizarHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-green-700 px-5 py-3 text-sm font-black uppercase tracking-wide text-white shadow-md transition hover:bg-green-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
            >
                <Icon name="simple-icons:whatsapp" class="h-4 w-4" aria-hidden="true" />
                Cotizar
            </a>
            <button
                type="button"
                data-menu-toggle
                aria-controls="menu-desktop"
                aria-expanded="false"
                aria-label="Abrir menú"
                class={iconButtonClass}
            >
                <Icon data-icon-open name="lucide:menu" class="h-5 w-5" aria-hidden="true" />
                <Icon data-icon-close name="lucide:x" class="hidden h-5 w-5" aria-hidden="true" />
            </button>
            <ClientLoginButton client:only="react" />
        </div>

        <div id="menu-desktop" hidden class="absolute right-5 top-full z-50 mt-2 w-72 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
            <ul class="space-y-1">
                {menuLinks.map(({ title, icon, url }) => (
                    <li>
                        <a href={url} class:list={["flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60", isActive(url) ? "text-purple-800" : "text-slate-700"]}>
                            <Icon name={`lucide:${icon}`} class="h-5 w-5 shrink-0" aria-hidden="true" />
                            {title}
                        </a>
                    </li>
                ))}
                <li>
                    <a href={ventasTelHref} class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60">
                        <Icon name="lucide:phone" class="h-5 w-5 shrink-0" aria-hidden="true" />
                        Llamar a ventas <span class="ml-auto text-xs font-medium text-slate-500">{ventasTelLabel}</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<!-- MÓVIL: barra superior con pagar, cotizar y menú -->
<header id="mobile-header" class="relative bg-white shadow-sm xl:hidden">
    <div class="flex items-center justify-between gap-3 px-4 py-3">
        <a href="/" class="shrink-0" aria-label="Tu Destino México, inicio">
            <img class="h-9 w-auto object-contain" src={logoUrl} alt="Tu Destino México" width="180" height="45" decoding="async">
        </a>

        <div class="flex items-center gap-2">
            <a href="/pagos" aria-label="Pagar en línea" class={iconButtonClass}>
                <Icon name="lucide:credit-card" class="h-5 w-5" aria-hidden="true" />
            </a>
            <a
                href={cotizarHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Cotizar por WhatsApp"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-green-700 text-white shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
            >
                <Icon name="simple-icons:whatsapp" class="h-5 w-5" aria-hidden="true" />
            </a>
            <button
                type="button"
                data-menu-toggle
                aria-controls="menu-mobile"
                aria-expanded="false"
                aria-label="Abrir menú"
                class={iconButtonClass}
            >
                <Icon data-icon-open name="lucide:menu" class="h-5 w-5" aria-hidden="true" />
                <Icon data-icon-close name="lucide:x" class="hidden h-5 w-5" aria-hidden="true" />
            </button>
        </div>
    </div>

    <div id="menu-mobile" hidden class="absolute inset-x-0 top-full z-50 max-h-[70vh] overflow-y-auto border-t border-slate-100 bg-white px-4 pb-6 pt-4 shadow-lg">
        <nav aria-label="Secciones" class="grid grid-cols-2 gap-3">
            {mobileMenuLinks.map(({ title, icon, url }) => (
                <a href={url} class:list={["flex items-center gap-3 rounded-2xl border border-slate-200 p-4 text-sm font-bold", isActive(url) ? "border-purple-800 text-purple-800" : "text-slate-700"]}>
                    <Icon name={`lucide:${icon}`} class="h-5 w-5 shrink-0" aria-hidden="true" />
                    {title}
                </a>
            ))}
        </nav>

        <div class="mt-4 flex items-center justify-between gap-3 rounded-2xl bg-slate-50 p-4">
            <a href={ventasTelHref} class="flex items-center gap-2 text-sm font-bold text-slate-800">
                <Icon name="lucide:phone" class="h-4 w-4" aria-hidden="true" />
                {ventasTelLabel}
            </a>
            <ClientLoginButton client:only="react" />
        </div>
    </div>
</header>

<!-- MÓVIL: barra inferior fija para la navegación principal y la acción de cotizar -->
<nav aria-label="Navegación principal" class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-6px_20px_rgba(15,23,42,0.08)] xl:hidden">
    <ul class="mx-auto grid max-w-md grid-cols-5 items-end px-2">
        {tabItems.slice(0, 2).map(({ title, icon, url }) => (
            <li>
                <a href={url} aria-current={isActive(url) ? "page" : undefined} class:list={["flex flex-col items-center gap-1 py-2.5 text-[11px] font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60 rounded-lg", isActive(url) ? "text-purple-800" : "text-slate-500"]}>
                    <Icon name={`lucide:${icon}`} class="h-5 w-5" aria-hidden="true" />
                    {title}
                </a>
            </li>
        ))}

        <li class="flex flex-col items-center">
            <a
                href={cotizarHref}
                target="_blank"
                rel="noopener noreferrer"
                class="-mt-5 flex h-14 w-14 items-center justify-center rounded-full bg-green-700 text-white shadow-lg ring-4 ring-white focus-visible:outline-none focus-visible:ring-green-700"
                aria-label="Cotizar por WhatsApp"
            >
                <Icon name="simple-icons:whatsapp" class="h-6 w-6" aria-hidden="true" />
            </a>
            <span class="pb-2 pt-1 text-[11px] font-black text-green-800">Cotizar</span>
        </li>

        {tabItems.slice(2).map(({ title, icon, url }) => (
            <li>
                <a href={url} aria-current={isActive(url) ? "page" : undefined} class:list={["flex flex-col items-center gap-1 py-2.5 text-[11px] font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-800/60 rounded-lg", isActive(url) ? "text-purple-800" : "text-slate-500"]}>
                    <Icon name={`lucide:${icon}`} class="h-5 w-5" aria-hidden="true" />
                    {title}
                </a>
            </li>
        ))}
    </ul>
</nav>

<style is:global>
    /* Deja espacio para la barra inferior fija en móvil y tablet. */
    @media (max-width: 1279px) {
        body {
            padding-bottom: calc(5rem + env(safe-area-inset-bottom));
        }
    }
</style>

<script>
    // Un solo mecanismo para los dos menús hamburguesa (escritorio y móvil).
    const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]'));

    const setPanel = (button: HTMLButtonElement, open: boolean) => {
        const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
        if (!panel) return;
        panel.hidden = !open;
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
        button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };

    const closeAll = (except?: HTMLButtonElement) => {
        toggles.forEach((button) => {
            if (button !== except && button.getAttribute('aria-expanded') === 'true') setPanel(button, false);
        });
    };

    toggles.forEach((button) => {
        button.addEventListener('click', () => {
            const willOpen = button.getAttribute('aria-expanded') !== 'true';
            closeAll(button);
            setPanel(button, willOpen);
        });
    });

    document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const open = toggles.find((button) => button.getAttribute('aria-expanded') === 'true');
        if (open) {
            setPanel(open, false);
            open.focus();
        }
    });

    document.addEventListener('mousedown', (event) => {
        const target = event.target as Node | null;
        if (!target) return;
        const insideMenu = toggles.some((button) => {
            const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
            return button.contains(target) || panel?.contains(target);
        });
        if (!insideMenu) closeAll();
    });

    document.querySelectorAll('[id^="menu-"] a').forEach((link) => {
        link.addEventListener('click', () => closeAll());
    });
</script>
