---
import TikTokCTA from "./ui/home/TikTokCTA.astro";
import HomeBanner from "./ui/home/HomeBanner.astro";
import { fetchHomeBanner } from "../lib/homeBanner";
import Content from "./layout/Content.astro";
import WelcomeModal from "./modal/WelcomeModal";
import OfficialAnnouncementModal from "./ui/OfficialAnnouncementModal.jsx";
import RecentlyViewed from "./ui/RecentlyViewed";
import FeaturedHotels from "./ui/home/FeaturedHotels.astro";
import FeaturedTours from "./ui/home/FeaturedTours.astro";
import { destinations } from "../data/destinations";

const homeBanner = await fetchHomeBanner();
---

<HomeBanner banner={homeBanner} />
<Content>
    <WelcomeModal client:only="react" />
    <OfficialAnnouncementModal client:only="react" />

    <RecentlyViewed client:only="react" />

    <TikTokCTA />

    <FeaturedHotels server:defer>
        <section slot="fallback" class="space-y-6" aria-busy="true" aria-labelledby="featured-hotels-heading">
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600">Hospedaje para tu viaje</p>
                    <h2 id="featured-hotels-heading" class="mt-2 text-3xl font-black tracking-tight text-slate-900">Hoteles destacados</h2>
                </div>
                <a href="/hoteles" class="font-bold text-indigo-700 hover:underline">Ver todos los hoteles</a>
            </div>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => <div class="h-[22rem] animate-pulse rounded-[2rem] bg-slate-100"></div>)}
            </div>
        </section>
    </FeaturedHotels>

    <section class="space-y-6 py-8" aria-labelledby="featured-destinations-heading">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-600">Inspírate para viajar</p>
                <h2 id="featured-destinations-heading" class="mt-2 text-3xl font-black tracking-tight text-slate-900">Explora destinos</h2>
            </div>
            <a href="/destinos" class="font-bold text-emerald-700 hover:underline">Ver todos los destinos</a>
        </div>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
            {destinations.slice(0, 8).map((destination) => (
                <a href={`/destinos/${destination.slug}/`} class="rounded-2xl border border-slate-200 bg-white p-4 transition hover:-translate-y-1 hover:shadow-lg">
                    <span class="text-sm font-black text-slate-900">{destination.name}</span>
                    <span class="mt-1 block text-xs text-slate-500">Hoteles y tours</span>
                </a>
            ))}
        </div>
    </section>

    <FeaturedTours />

</Content>
