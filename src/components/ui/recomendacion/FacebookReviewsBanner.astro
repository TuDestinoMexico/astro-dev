---
const reviewsUrl = "https://www.facebook.com/tudestinomexicoo/reviews/";
---

<a
    href={reviewsUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Ver reseñas de Tu Destino MX en Facebook (abre en una pestaña nueva)"
    class="group my-6 block overflow-hidden rounded-xl focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
>
    <div class="relative isolate aspect-[3/2] overflow-hidden bg-sky-100 transition duration-300 group-hover:brightness-[1.03] md:aspect-[3/1]">
        <picture class="absolute inset-0 -z-10">
            <source media="(max-width: 767px)" srcset="/images/banners/facebook-resenas-mobile.png" />
            <img
                src="/images/banners/facebook-resenas-desktop.png"
                alt=""
                aria-hidden="true"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
            />
        </picture>
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-white/80 via-white/30 to-transparent md:bg-gradient-to-r md:from-white/80 md:via-white/35 md:to-transparent"></div>
        <div class="flex h-full max-w-[58%] flex-col justify-start gap-2 px-4 pt-4 text-left sm:px-7 sm:pt-7 md:max-w-[52%] md:justify-center md:px-12 md:py-8">
            <div class="text-xs font-bold uppercase tracking-wide text-purple-800 sm:text-sm">
                Tu Destino México en Facebook
            </div>
            <h2 class="text-xl font-extrabold leading-tight text-purple-950 sm:text-2xl md:text-4xl">
                Lee nuestras reseñas
            </h2>
            <p class="hidden text-sm font-medium text-slate-800 sm:block md:text-base">
                Conoce la experiencia de otros viajeros.
            </p>
            <span class="mt-1 inline-flex w-fit items-center rounded-full bg-blue-700 px-4 py-2 text-sm font-bold text-white shadow-md transition group-hover:bg-blue-800 md:px-5 md:py-2.5 md:text-base">
                Ver reseñas
            </span>
        </div>
    </div>
</a>
