---
interface Item {
    label: string;
    href?: string;
}

interface Props {
    items: Item[];
}

const { items } = Astro.props;
const schema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: item.href ? new URL(item.href, Astro.site ?? Astro.url).href : Astro.url.href
    }))
};
---

<nav aria-label="Breadcrumb" class="text-sm text-slate-500">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
        {items.map((item, index) => (
            <li class="flex items-center gap-x-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                {item.href ? (
                    <a href={item.href} class="hover:text-indigo-700 hover:underline">{item.label}</a>
                ) : (
                    <span aria-current="page" class="text-slate-700">{item.label}</span>
                )}
            </li>
        ))}
    </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
