---
const tiktokUrl = "https://tiktok.com/@tudestinomexico";
const previewImage = "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=720&h=1280&q=78";
---

<section class="my-16 container mx-auto" aria-labelledby="tiktok-cta-title">
    <div class="tiktok-cta relative isolate overflow-hidden rounded-[2rem] bg-[#09090b] px-6 py-10 text-white shadow-2xl sm:rounded-[2.5rem] sm:px-10 md:py-14 lg:px-16">
        <div class="pointer-events-none absolute -left-32 top-1/2 -z-10 h-80 w-80 -translate-y-1/2 rounded-full bg-[#25f4ee]/10 blur-[100px]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-24 -top-32 -z-10 h-96 w-96 rounded-full bg-[#fe2c55]/15 blur-[110px]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute inset-0 -z-10 opacity-30" aria-hidden="true">
            <div class="absolute inset-x-0 top-1/2 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
            <div class="absolute right-[27%] top-0 h-full w-px rotate-[22deg] bg-gradient-to-b from-transparent via-[#25f4ee]/30 to-transparent"></div>
        </div>

        <div class="relative z-10 flex flex-col items-center gap-12 lg:flex-row lg:justify-between lg:gap-16">
            <div class="max-w-2xl flex-1 text-center lg:text-left">
                <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.06] px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.22em] text-zinc-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#25f4ee] shadow-[0_0_12px_#25f4ee]" aria-hidden="true"></span>
                    Síguenos en TikTok
                </div>

                <h2 id="tiktok-cta-title" class="max-w-2xl text-4xl font-black leading-[0.98] tracking-tight text-white sm:text-5xl md:text-6xl">
                    Tu próximo viaje empieza en tu <span class="tiktok-gradient-text">Para Ti.</span>
                </h2>

                <p class="mt-6 max-w-xl text-base leading-7 text-zinc-400 sm:text-lg">
                    Escapadas, hoteles, tours y tips reales para encontrar tu próximo destino antes de que se vuelva tendencia.
                </p>

                <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row lg:items-center">
                    <a
                        href={tiktokUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-white px-6 py-3.5 text-sm font-black text-zinc-950 shadow-xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:bg-[#25f4ee] focus:outline-none focus:ring-2 focus:ring-[#25f4ee] focus:ring-offset-2 focus:ring-offset-[#09090b] sm:w-auto"
                    >
                        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-zinc-950 text-white" aria-hidden="true">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-2-2.74V9.43a6.35 6.35 0 1 0 5.45 6.27V8.42a8.27 8.27 0 0 0 4.84 1.56V6.69h-1.07Z" />
                            </svg>
                        </span>
                        Ver @tudestinomexico
                        <span aria-hidden="true" class="text-lg leading-none">↗</span>
                    </a>
                    <span class="text-xs font-bold tracking-wide text-zinc-500">Videos cortos. Ideas grandes para viajar.</span>
                </div>
            </div>

            <div class="relative shrink-0" aria-label="Vista previa de un video de Tu Destino México en TikTok">
                <div class="absolute -left-3 top-5 h-[19rem] w-[10.75rem] rotate-[-8deg] rounded-[1.7rem] border border-[#25f4ee]/40 bg-[#25f4ee]/10 shadow-[0_0_35px_rgba(37,244,238,0.18)] sm:h-[23rem] sm:w-[13rem]" aria-hidden="true"></div>
                <div class="absolute -right-3 top-8 h-[19rem] w-[10.75rem] rotate-[8deg] rounded-[1.7rem] border border-[#fe2c55]/40 bg-[#fe2c55]/10 shadow-[0_0_35px_rgba(254,44,85,0.18)] sm:h-[23rem] sm:w-[13rem]" aria-hidden="true"></div>

                <div class="relative h-[20rem] w-[11.25rem] overflow-hidden rounded-[1.8rem] border-[5px] border-zinc-800 bg-zinc-900 shadow-2xl shadow-black/50 sm:h-[24rem] sm:w-[13.5rem]">
                    <img
                        src={previewImage}
                        alt="Playa del Caribe, una experiencia de viaje de Tu Destino México"
                        class="h-full w-full object-cover"
                        width="720"
                        height="1280"
                        loading="lazy"
                        decoding="async"
                    />
                    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/80" aria-hidden="true"></div>

                    <div class="absolute left-3 right-3 top-3 flex items-center justify-between text-[9px] font-black uppercase tracking-[0.14em] text-white/90">
                        <span>Para Ti</span>
                        <span class="rounded-full bg-black/30 px-2 py-1 backdrop-blur-sm">01 / 05</span>
                    </div>

                    <div class="absolute bottom-3 left-3 right-3">
                        <div class="mb-3 flex items-center gap-2 text-[10px] font-bold text-white">
                            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-white text-[11px] font-black text-zinc-950">T</span>
                            @tudestinomexico
                        </div>
                        <p class="text-xs font-bold leading-4 text-white">Un destino increíble está más cerca de lo que imaginas.</p>
                        <div class="mt-3 h-0.5 w-full overflow-hidden rounded-full bg-white/30"><div class="h-full w-2/5 bg-white"></div></div>
                    </div>

                    <div class="absolute bottom-16 -right-1 flex flex-col items-center gap-3 text-white" aria-hidden="true">
                        <span class="flex flex-col items-center gap-0.5 text-[9px] font-black"><span class="text-xl">♥</span> 2.4K</span>
                        <span class="flex flex-col items-center gap-0.5 text-[9px] font-black"><span class="text-xl">◌</span> 128</span>
                        <span class="flex flex-col items-center gap-0.5 text-[9px] font-black"><span class="text-xl">↗</span> 64</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .tiktok-gradient-text {
        color: transparent;
        background: linear-gradient(100deg, #25f4ee 0%, #ffffff 42%, #fe2c55 100%);
        background-clip: text;
        -webkit-background-clip: text;
    }

    @media (prefers-reduced-motion: no-preference) {
        .tiktok-cta {
            animation: tiktok-glow 8s ease-in-out infinite alternate;
        }
    }

    @keyframes tiktok-glow {
        from { box-shadow: 0 25px 70px -35px rgba(37, 244, 238, 0.28); }
        to { box-shadow: 0 25px 70px -35px rgba(254, 44, 85, 0.34); }
    }
</style>
