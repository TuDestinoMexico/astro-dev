---
const tiktokUrl = "https://tiktok.com/@tudestinomexico";
// Imagen propia optimizada (536 × 960, proporción 9:16), servida desde public/.
const previewImage = "/images/tiktok/para-ti-01.jpg";
---

<section class="my-16 container mx-auto" aria-labelledby="tiktok-cta-title">
    <div class="tiktok-cta relative isolate overflow-hidden rounded-[2rem] bg-[#09090b] px-6 py-10 text-white shadow-2xl sm:rounded-[2.5rem] sm:px-10 md:py-14 lg:px-16">
        <div class="pointer-events-none absolute -left-32 top-1/2 -z-10 h-80 w-80 -translate-y-1/2 rounded-full bg-[#25f4ee]/10 blur-[100px]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-24 -top-32 -z-10 h-96 w-96 rounded-full bg-[#fe2c55]/15 blur-[110px]" aria-hidden="true"></div>

        <div class="relative z-10 grid items-center gap-12 lg:grid-cols-[1fr_auto] lg:gap-16">
            <div class="text-center lg:text-left">
                <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.06] px-3.5 py-1.5 text-[10px] font-black uppercase tracking-[0.22em] text-zinc-300">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#25f4ee] shadow-[0_0_12px_#25f4ee]" aria-hidden="true"></span>
                    Síguenos en TikTok
                </div>

                <h2 id="tiktok-cta-title" class="mx-auto max-w-2xl text-4xl font-black leading-[0.98] tracking-tight text-white sm:text-5xl md:text-6xl lg:mx-0">
                    Tu próximo viaje empieza en tu <span class="tiktok-gradient-text">Para Ti.</span>
                </h2>

                <p class="mx-auto mt-6 max-w-xl text-base leading-7 text-zinc-400 sm:text-lg lg:mx-0">
                    Escapadas, hoteles, tours y tips reales para encontrar tu próximo destino antes de que se vuelva tendencia.
                </p>

                <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row lg:items-center">
                    <a
                        href={tiktokUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-white py-3.5 pl-3.5 pr-6 text-sm font-black text-zinc-950 shadow-xl shadow-black/30 transition duration-300 hover:-translate-y-0.5 hover:bg-[#25f4ee] hover:shadow-[0_18px_40px_-12px_rgba(37,244,238,0.45)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25f4ee] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090b] sm:w-auto"
                    >
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-zinc-950 text-white transition-transform duration-300 group-hover:rotate-[-6deg]" aria-hidden="true">
                            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-2-2.74V9.43a6.35 6.35 0 1 0 5.45 6.27V8.42a8.27 8.27 0 0 0 4.84 1.56V6.69h-1.07Z" />
                            </svg>
                        </span>
                        Ver @tudestinomexico
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 17 17 7M8 7h9v9" />
                        </svg>
                    </a>
                    <span class="text-xs font-bold tracking-wide text-zinc-500">Videos cortos. Ideas grandes para viajar.</span>
                </div>
            </div>

            <div class="relative mx-auto shrink-0" aria-hidden="true">
                <div class="absolute -left-4 top-6 h-[19rem] w-[10.75rem] rotate-[-8deg] rounded-[1.7rem] border border-[#25f4ee]/35 bg-[#25f4ee]/[0.07] sm:h-[23rem] sm:w-[13rem]"></div>
                <div class="absolute -right-4 top-9 h-[19rem] w-[10.75rem] rotate-[8deg] rounded-[1.7rem] border border-[#fe2c55]/35 bg-[#fe2c55]/[0.07] sm:h-[23rem] sm:w-[13rem]"></div>

                <div class="relative h-[20rem] w-[11.25rem] overflow-hidden rounded-[1.8rem] border-[5px] border-zinc-800 bg-zinc-900 shadow-2xl shadow-black/60 sm:h-[24rem] sm:w-[13.5rem]">
                    <img
                        src={previewImage}
                        alt=""
                        class="h-full w-full object-cover"
                        width="536"
                        height="960"
                        loading="lazy"
                        decoding="async"
                    />
                    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-transparent to-black/85"></div>

                    <div class="absolute inset-x-3 top-3 flex items-center justify-between text-[9px] font-black uppercase tracking-[0.14em] text-white/90">
                        <span>Para Ti</span>
                        <span class="rounded-full bg-black/35 px-2 py-1 backdrop-blur-sm">01 / 05</span>
                    </div>

                    {/* Acciones dentro de la pantalla, con margen para que no se corten */}
                    <div class="absolute bottom-20 right-2.5 flex flex-col items-center gap-3.5 text-white">
                        <span class="flex flex-col items-center gap-0.5 text-[9px] font-black">
                            <svg class="h-5 w-5 fill-[#fe2c55] stroke-[#fe2c55]" viewBox="0 0 24 24" stroke-width="1.5"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
                            2.4K
                        </span>
                        <span class="flex flex-col items-center gap-0.5 text-[9px] font-black">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
                            128
                        </span>
                        <span class="flex flex-col items-center gap-0.5 text-[9px] font-black">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path d="M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path d="M18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98" /></svg>
                            64
                        </span>
                    </div>

                    <div class="absolute inset-x-3 bottom-3">
                        <div class="mb-2.5 flex items-center gap-2 text-[10px] font-bold text-white">
                            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-white text-[11px] font-black text-zinc-950">T</span>
                            @tudestinomexico
                        </div>
                        <p class="pr-8 text-xs font-bold leading-4 text-white">Un destino increíble está más cerca de lo que imaginas.</p>
                        <div class="mt-3 h-0.5 w-full overflow-hidden rounded-full bg-white/30"><div class="h-full w-2/5 bg-white"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .tiktok-gradient-text {
        color: transparent;
        background: linear-gradient(100deg, #25f4ee 0%, #ffffff 42%, #fe2c55 100%);
        background-clip: text;
        -webkit-background-clip: text;
    }

    @media (prefers-reduced-motion: no-preference) {
        .tiktok-cta {
            animation: tiktok-glow 8s ease-in-out infinite alternate;
        }
    }

    @keyframes tiktok-glow {
        from { box-shadow: 0 25px 70px -35px rgba(37, 244, 238, 0.28); }
        to { box-shadow: 0 25px 70px -35px rgba(254, 44, 85, 0.34); }
    }
</style>
