---
import Grid from '../Grid.astro';
import Card from '../single/Card.astro';
import { fetchHotelList } from '../../../lib/catalog';

const catalogResult = await fetchHotelList<any>();
const catalogUnavailable = catalogResult.status === 'unavailable';
const hoteles = catalogResult.status === 'ok' ? catalogResult.data : [];
---

<section class="space-y-6" aria-labelledby="featured-hotels-heading">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600">Hospedaje para tu viaje</p>
            <h2 id="featured-hotels-heading" class="mt-2 text-3xl font-black tracking-tight text-slate-900">Hoteles destacados</h2>
        </div>
        <a href="/hoteles" class="font-bold text-indigo-700 hover:underline">Ver todos los hoteles</a>
    </div>

    {catalogUnavailable ? (
        <div class="px-4 py-12 text-center">
            <p class="font-semibold text-gray-700">El catálogo de hoteles no está disponible temporalmente.</p>
            <p class="mt-2 text-gray-500">Puedes continuar explorando el sitio o contactarnos para recibir asesoría.</p>
        </div>
    ) : hoteles.length > 0 ? (
        <Grid grid={5}>
            {hoteles.slice(0, 5).map(
                (hotel: { name: string | undefined; slug: string | undefined; images: any; destino: string | undefined }) => (
                    <Card
                        title={hotel.name}
                        slug={hotel.slug}
                        photo={hotel.images}
                        type="hotel"
                        destino={hotel.destino}
                    />
                )
            )}
        </Grid>
    ) : (
        <div class="px-4 py-12 text-center">
            <p class="italic text-gray-500">No se encontraron hoteles disponibles en este momento.</p>
        </div>
    )}
</section>
