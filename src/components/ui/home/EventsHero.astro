---
import { Icon } from 'astro-icon/components';
import EventsHeroControls from './EventsHeroControls';
import { fetchHomeHero } from '../../../lib/homeHero';

const heroData = await fetchHomeHero();
const firstSlide = heroData.slides[0];
const whatsappHref = firstSlide && heroData.whatsappNumber && firstSlide.whatsappMsg
    ? `https://wa.me/${heroData.whatsappNumber}?text=${encodeURIComponent(firstSlide.whatsappMsg)}`
    : '';
---

{firstSlide && (
<section id="home-hero" class="w-full overflow-hidden font-sans" aria-label="Destinos y experiencias de Tu Destino México">
    <div class="hero-shell relative h-[650px] w-full bg-brand-surface md:h-[720px]">
        <div class="hero-visual absolute inset-x-0 top-0 h-[43%] overflow-hidden md:inset-y-0 md:left-auto md:right-0 md:h-full md:w-[64%]">
            <img
                data-hero-image
                src={firstSlide.image}
                alt={firstSlide.alt || firstSlide.title}
                width="1600"
                height="1067"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-brand-ink/20 via-transparent to-brand-ink/65 md:bg-gradient-to-r md:from-brand-ink/70 md:via-brand-ink/10 md:to-transparent"></div>
            <div class="absolute right-5 top-5 flex items-center gap-2 rounded-pill border border-white/30 bg-brand-ink/25 px-3 py-2 text-[9px] font-black uppercase tracking-[0.18em] text-white backdrop-blur-md md:right-10 md:top-10">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
                <span data-hero-meta>{firstSlide.meta}</span>
            </div>
            <div class="absolute bottom-5 left-5 flex items-end gap-3 text-white md:bottom-10 md:left-auto md:right-10">
                <span class="text-[10px] font-black uppercase tracking-[0.28em] text-white/60">Destino</span>
                <span data-hero-location class="text-sm font-bold tracking-tight md:text-base"><span data-hero-location-text>{firstSlide.location}</span></span>
            </div>
        </div>

        <div class="hero-panel absolute bottom-0 left-0 z-20 h-[62%] w-full bg-brand-ink px-6 pb-24 pt-7 text-white md:inset-y-0 md:h-full md:w-[53%] md:px-16 md:pb-20 md:pt-16">
            <div class="relative flex h-full max-w-xl flex-col justify-center">
                <div class="absolute -left-6 top-1/2 hidden h-px w-20 bg-brand-primary/70 md:block" aria-hidden="true"></div>
                <div class="mb-5 flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.26em] text-brand-primary">
                    <span data-hero-index>01</span>
                    <span class="h-px w-8 bg-brand-primary/60"></span>
                    <span data-hero-eyebrow>{firstSlide.eyebrow}</span>
                </div>

                <div class="overflow-hidden">
                    <h1 data-hero-title class="max-w-xl text-[2.75rem] font-black uppercase leading-[0.92] tracking-[-0.06em] text-white sm:text-6xl md:text-7xl">
                        {firstSlide.title}
                    </h1>
                </div>

                <div class="mt-6 overflow-hidden md:mt-7">
                    <p data-hero-description class="max-w-lg text-sm font-medium leading-6 text-white/70 md:text-base md:leading-7">
                        {firstSlide.description}
                    </p>
                </div>

                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-4 md:mt-9">
                    <a
                        data-hero-cta
                        href={whatsappHref || '#'}
                        target="_blank"
                        rel="noopener noreferrer"
                        hidden={!whatsappHref || !firstSlide.ctaLabel}
                        class="inline-flex w-full items-center justify-center gap-2.5 rounded-card bg-brand-primary px-6 py-4 text-xs font-black uppercase tracking-[0.12em] text-white shadow-lg shadow-brand-primary/20 transition-all hover:-translate-y-0.5 hover:bg-brand-primary-hover focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 focus:ring-offset-brand-ink active:translate-y-0 sm:w-auto"
                    >
                        <Icon name="simple-icons:whatsapp" size="19" class="shrink-0" aria-hidden="true" />
                        <span data-hero-cta-label>{firstSlide.ctaLabel}</span>
                    </a>
                    <a
                        data-hero-secondary
                        href={firstSlide.secondaryHref || '#'}
                        hidden={!firstSlide.secondaryHref || !firstSlide.secondaryLabel}
                        class="inline-flex w-full items-center justify-center gap-2 text-xs font-black uppercase tracking-[0.12em] text-white/75 transition-colors hover:text-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 focus:ring-offset-brand-ink sm:w-auto"
                    >
                        <span data-hero-secondary-label>{firstSlide.secondaryLabel}</span>
                        <Icon name="lucide:arrow-up-right" size="17" aria-hidden="true" />
                    </a>
                </div>

                <div class="absolute bottom-0 left-0 hidden items-center gap-3 text-[9px] font-bold uppercase tracking-[0.2em] text-white/40 md:flex">
                    <span class="h-px w-8 bg-white/30"></span>
                    <span>Viajes con intención</span>
                </div>
            </div>
        </div>

        {heroData.slides.length > 1 && <EventsHeroControls client:load slides={heroData.slides} whatsappNumber={heroData.whatsappNumber} autoplayMs={heroData.autoplayMs} />}
    </div>
</section>
)}

<style>
    .hero-visual {
        clip-path: polygon(0 0, 100% 0, 100% 100%, 12% 100%);
    }

    .hero-panel {
        clip-path: polygon(0 0, 92% 0, 100% 50%, 92% 100%, 0 100%);
    }

    @media (max-width: 767px) {
        .hero-visual,
        .hero-panel {
            clip-path: none;
        }
    }
</style>
