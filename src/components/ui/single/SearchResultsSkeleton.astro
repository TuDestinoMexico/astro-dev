---
import { Icon } from 'astro-icon/components';

interface Props {
    count?: number;
    label?: string;
}

const { count = 8, label = 'Buscando tus próximas vacaciones' } = Astro.props;
---

<div data-search-skeleton role="status" aria-live="polite" class="w-full">
    <div class="mb-10 flex items-center justify-center gap-3 text-center">
        <Icon name="lucide:sparkles" class="h-5 w-5 animate-pulse text-emerald-500" aria-hidden="true" />
        <p class="text-sm font-black uppercase tracking-[0.18em] text-gray-600">{label}</p>
        <Icon name="lucide:palmtree" class="h-5 w-5 animate-pulse text-emerald-500" aria-hidden="true" />
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {Array.from({ length: count }).map(() => (
            <div class="overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-sm">
                <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
                    <div class="absolute inset-0 animate-pulse bg-gradient-to-br from-slate-100 via-white to-slate-100"></div>
                    <Icon name="lucide:waves" class="absolute left-1/2 top-1/2 h-10 w-10 -translate-x-1/2 -translate-y-1/2 text-slate-300" aria-hidden="true" />
                </div>
                <div class="space-y-4 p-5">
                    <div class="h-4 w-3/4 animate-pulse rounded-full bg-slate-200"></div>
                    <div class="flex items-center gap-2">
                        <Icon name="lucide:map-pin" class="h-3.5 w-3.5 text-slate-300" aria-hidden="true" />
                        <div class="h-3 w-1/2 animate-pulse rounded-full bg-slate-100"></div>
                    </div>
                    <div class="h-10 w-full animate-pulse rounded-full bg-slate-100"></div>
                </div>
            </div>
        ))}
    </div>
</div>

<noscript>
    <style>
        [data-search-skeleton] { display: none !important; }
        [data-search-results] { display: block !important; }
    </style>
</noscript>

<style is:global>
    .animate-fade-in {
        animation: tdmxSearchFade 0.5s ease forwards;
    }

    @keyframes tdmxSearchFade {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    // Mantiene el skeleton visible un momento para que la búsqueda se sienta personal,
    // y luego muestra los resultados ya renderizados. Con movimiento reducido el tiempo es menor.
    const skeleton = document.querySelector<HTMLElement>('[data-search-skeleton]');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (skeleton && results) {
        window.setTimeout(() => {
            skeleton.classList.add('hidden');
            results.classList.remove('hidden');
            if (!reduceMotion) results.classList.add('animate-fade-in');
        }, reduceMotion ? 300 : 1400);
    }
</script>
