---
import Analytics from '@vercel/analytics/astro'
import { SEO } from "astro-seo"
import "../assets/styles/global.css"
import MatchPoll from '../components/ui/home/MatchPoll'

interface Props {
	title?: string
	description?: string
	image?: string
	type?: 'website' | 'article'
}

const { title, description, image, type = 'website' } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href
const ogImage = image || 'https://storage.googleapis.com/tudestinomx_bucket/assets/og-default.jpg'
const ogTitle = title || 'Tu Destino México | Agencia de Viajes en Cancún'
const siteName = 'Tu Destino México'
const twitterHandle = '@tudestinomexico'

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Tu Destino México',
	url: 'https://tudestinomx.com',
	logo: 'https://storage.googleapis.com/tudestinomx_bucket/assets/test/tdmx_logo_mundial.png',
	sameAs: [
		'https://fb.com/tudestinomexicoo',
		'https://instagram.com/tudestinomexico',
		'https://tiktok.com/@tudestinomexico',
		'https://youtube.com/@tudestinomexico'
	],
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '+52-998-980-6611',
		contactType: 'customer service',
		availableLanguage: ['Spanish'],
		areaServed: 'MX'
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Cancún',
		addressRegion: 'Quintana Roo',
		addressCountry: 'MX'
	}
}

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Tu Destino México',
	url: 'https://tudestinomx.com',
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: 'https://tudestinomx.com/buscar?q={search_term_string}'
		},
		'query-input': 'required name=search_term_string'
	},
	publisher: organizationSchema
}
---
<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="https://storage.googleapis.com/tudestinomx_bucket/assets/favicon/32h/tdmxicon.png" />
		<link rel="icon" href="https://storage.googleapis.com/tudestinomx_bucket/assets/favicon/32h/tdmxicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalURL} />
		<SEO
			title={title}
			description={description}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					title: ogTitle,
					type,
					image: ogImage,
					url: canonicalURL
				},
				optional: {
					description,
					locale: 'es_MX',
					siteName: 'Tu Destino México'
				}
			}}
			twitter={{
				card: 'summary_large_image',
				site: twitterHandle,
				creator: twitterHandle,
				title: ogTitle,
				description,
				image: ogImage
			}}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body>
		<slot />
	</body>
	<Analytics/>
</html>

<style>
	:root {
		--font-poppins: 'Poppins', sans-serif;
	}

	body {
		font-family: var(--font-poppins);
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
