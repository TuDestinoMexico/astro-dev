---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Content from "../components/layout/Content.astro";
import HeroBanner from "../components/ui/single/HeroBanner.astro";
import Card from "../components/ui/single/Card.astro";
import { fetchTourList } from "../lib/catalog";

const catalogResult = await fetchTourList<any>();
const catalogUnavailable = catalogResult.status === 'unavailable';
const tours = catalogResult.status === 'ok' ? catalogResult.data : [];

const tourListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: tours.slice(0, 20).map((tour: any, index: number) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
            '@type': ['TouristAttraction', 'Event'],
            name: tour.name,
            url: `https://tudestinomx.com/tour/${tour.slug}`,
            image: tour.images?.principal?.[0]?.url || tour.imagenes,
            location: {
                '@type': 'Place',
                address: {
                    '@type': 'PostalAddress',
                    addressLocality: tour.destino,
                    addressRegion: 'Quintana Roo',
                    addressCountry: 'MX'
                }
            },
            aggregateRating: tour.reviews && tour.reviews_count ? {
                '@type': 'AggregateRating',
                ratingValue: parseFloat(tour.reviews),
                reviewCount: tour.reviews_count,
                bestRating: '5',
                worstRating: '1'
            } : undefined,
            offers: tour.price ? {
                '@type': 'Offer',
                priceCurrency: 'MXN',
                price: tour.price,
                availability: 'https://schema.org/InStock'
            } : undefined
        }
    })),
    numberOfItems: tours.length
};
---

<Layout 
  title="Tours y Experiencias en México | Tu Destino México" 
  description="Descubre las mejores aventuras: snorkel en Cozumel, ruinas mayas, nado con delfines y más. Tours guiados con transporte incluido. ¡Reserva ahora!"
  image="https://images.unsplash.com/photo-1544735745-b89b18555f60?q=80&w=2070&auto=format&fit=crop"
  type="website"
>
    <Header/>

    {!catalogUnavailable && (
        <script type="application/ld+json" set:html={JSON.stringify(tourListSchema)} />
    )}

    <Content>
        <HeroBanner
                title="Nuestros Tours"
                imageSrc="https://images.unsplash.com/photo-1544735745-b89b18555f60?q=80&w=2070&auto=format&fit=crop"
                altText="Fondo sección de tours y aventuras"
        />

        <div class="max-w-7xl mx-auto px-6 py-12">

            <div class="mb-12 text-center">
                <p class="text-xl font-bold text-purple-800 mb-2">Aventuras Inolvidables</p>
                <h2 class="text-3xl font-extrabold text-gray-800 uppercase">Descubre las mejores experiencias</h2>
            </div>

            {catalogUnavailable ? (
                    <div class="text-center py-20">
                        <p class="text-gray-700 font-semibold">El catálogo de tours no está disponible temporalmente.</p>
                        <p class="text-gray-500 mt-2">Intenta nuevamente más tarde o contáctanos para encontrar una experiencia.</p>
                    </div>
            ) : tours.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {tours.map((tour: any) => (
                                <Card
                                        title={tour.name || tour.title}
                                        slug={tour.slug}
                                        type="tour"
                                        destino={tour.destino}
                                        photo={tour.images || tour.imagenes}
                                />
                        ))}
                    </div>
            ) : (
                    <div class="text-center py-20">
                        <p class="text-gray-500 italic">No se encontraron tours disponibles en este momento.</p>
                    </div>
            )}
        </div>
    </Content>

    <Footer/>
</Layout>
