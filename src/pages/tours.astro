---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Content from "../components/layout/Content.astro";
import HeroBanner from "../components/ui/single/HeroBanner.astro";
import Card from "../components/ui/single/Card.astro";
import SearchSummary from "../components/ui/single/SearchSummary.astro";
import SearchResultsSkeleton from "../components/ui/single/SearchResultsSkeleton.astro";
import SearchEditor from "../components/ui/single/SearchEditor";
import { fetchTourList } from "../lib/catalog";
import { hasSearchFilters, matchesDestino, parseSearchQuery, toSearchString } from "../lib/searchParams";

const catalogResult = await fetchTourList<any>();
const catalogUnavailable = catalogResult.status === 'unavailable';
const toursDisponibles = catalogResult.status === 'ok' ? catalogResult.data : [];

// El buscador de la portada llega aquí con destino, fecha y viajeros en la URL.
const searchQuery = parseSearchQuery(Astro.url.searchParams);
const searchFiltered = hasSearchFilters(searchQuery);
const tours = searchQuery.destino
    ? toursDisponibles.filter((tour: any) => matchesDestino(tour, searchQuery.destino))
    : toursDisponibles;
const searchQueryString = toSearchString(searchQuery);
const searchInitial = {
    tipo: 'tour' as const,
    destino: searchQuery.destino,
    fecha: searchQuery.fecha,
    adultos: searchQuery.adultos,
    menores: searchQuery.menores,
    edades: searchQuery.edades,
};
const whatsappNoResultsUrl = `https://wa.me/529987141365?text=${encodeURIComponent(
    `Hola, busqué "${searchQuery.destino}" en su sitio de tours y no encontré opciones publicadas. ¿Me pueden ayudar?`
)}`;
const toursHeroImage = new URL('/images/banners/tours-desktop.jpg', Astro.site ?? 'https://tudestinomx.com').href;

const tourListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: tours.slice(0, 20).map((tour: any, index: number) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
            '@type': 'TouristAttraction',
            name: tour.name,
            url: `https://tudestinomx.com/tour/${tour.slug}`,
            image: tour.images?.principal?.[0]?.url || tour.imagenes,
            location: {
                '@type': 'Place',
                address: {
                    '@type': 'PostalAddress',
                    addressLocality: tour.destino || undefined
                }
            },
            aggregateRating: tour.reviews && tour.reviews_count ? {
                '@type': 'AggregateRating',
                ratingValue: parseFloat(tour.reviews),
                reviewCount: tour.reviews_count,
                bestRating: '5',
                worstRating: '1'
            } : undefined,
            offers: tour.price ? {
                '@type': 'Offer',
                priceCurrency: 'MXN',
                price: tour.price,
                availability: 'https://schema.org/InStock'
            } : undefined
        }
    })),
    numberOfItems: tours.length
};
---

<Layout 
  title="Tours y Excursiones en Cancún y México | Tu Destino MX"
  description="Descubre tours, excursiones y experiencias en Cancún, Riviera Maya y otros destinos. Recibe recomendaciones y cotiza tu actividad."
  image={toursHeroImage}
  type="website"
>
    <Header/>

    {!catalogUnavailable && (
        <script type="application/ld+json" set:html={JSON.stringify(tourListSchema)} />
    )}

    <Content>
        <HeroBanner
                title="Nuestros Tours"
                imageSrc="/images/banners/tours-desktop.jpg"
                mobileImageSrc="/images/banners/tours-mobile.jpg"
                altText="Excursión en catamarán por el mar Caribe mexicano"
        />

        <div class="max-w-7xl mx-auto px-6 py-12">

            <div class="mb-12 text-center">
                <p class="text-xl font-bold text-purple-800 mb-2">Aventuras inolvidables</p>
                <h2 class="text-3xl font-extrabold text-gray-800 uppercase">Tours y experiencias para tu viaje</h2>
                <p class="mx-auto mt-4 max-w-3xl leading-7 text-gray-600">Encuentra actividades acuáticas, recorridos culturales y aventuras para disfrutar tus vacaciones. Consulta disponibilidad y recibe asesoría antes de reservar.</p>
            </div>

            {searchFiltered && <SearchResultsSkeleton label="Buscando tus próximas aventuras" />}

            <div data-search-results class={searchFiltered ? 'hidden' : undefined}>
            {!catalogUnavailable && searchFiltered && (
                    <div>
                        <SearchSummary query={searchQuery} tipo="tour" total={tours.length} filtrado={Boolean(searchQuery.destino)} />
                        <SearchEditor client:load initial={searchInitial} />
                    </div>
            )}

            {catalogUnavailable ? (
                    <div class="text-center py-20">
                        <p class="text-gray-700 font-semibold">El catálogo de tours no está disponible temporalmente.</p>
                        <p class="text-gray-500 mt-2">Intenta nuevamente más tarde o contáctanos para encontrar una experiencia.</p>
                    </div>
            ) : tours.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {tours.map((tour: any) => (
                                <Card
                                        title={tour.name || tour.title}
                                        slug={tour.slug}
                                        type="tour"
                                        destino={tour.destino}
                                        photo={tour.images || tour.imagenes}
                                        query={searchQueryString}
                                />
                        ))}
                    </div>
            ) : (
                    <div class="mx-auto max-w-2xl py-16 text-center">
                        {searchFiltered ? (
                            <>
                                <p class="text-xl font-extrabold text-gray-800">
                                    {searchQuery.destino ? `No encontramos tours para "${searchQuery.destino}"` : 'No encontramos tours con esa búsqueda'}
                                </p>
                                <p class="mt-3 leading-7 text-gray-600">
                                    Revisa la ortografía o prueba con otro destino. También puedes escribirnos y te ayudamos a encontrar una experiencia.
                                </p>
                                <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                                    <a href="/tours" class="rounded-full border border-gray-300 px-6 py-3 font-bold text-gray-800 transition hover:border-purple-700">Ver todos los tours</a>
                                    <a href={whatsappNoResultsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-emerald-600 px-6 py-3 font-bold text-white transition hover:bg-emerald-700">Escribir a un asesor</a>
                                </div>
                            </>
                        ) : (
                            <p class="text-gray-500 italic">No se encontraron tours disponibles en este momento.</p>
                        )}
                    </div>
            )}
            </div>
        </div>
    </Content>

    <Footer/>
</Layout>
