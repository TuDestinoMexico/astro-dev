---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Content from "../components/layout/Content.astro";
import HeroBanner from "../components/ui/single/HeroBanner.astro";
import Card from "../components/ui/single/Card.astro";
import HeroBannerOutBounds from "../components/ui/single/HeroBannerOutBounds.astro";
import SearchSummary from "../components/ui/single/SearchSummary.astro";
import SearchResultsSkeleton from "../components/ui/single/SearchResultsSkeleton.astro";
import SearchEditor from "../components/ui/single/SearchEditor";
import MobileRail from "../components/ui/single/MobileRail.astro";
import { fetchHotelList } from "../lib/catalog";
import { hasSearchFilters, matchesDestino, parseSearchQuery, toSearchString } from "../lib/searchParams";

const catalogResult = await fetchHotelList<any>();
const catalogUnavailable = catalogResult.status === 'unavailable';
const hotelesActivos = catalogResult.status === 'ok'
    ? catalogResult.data.filter((hotel: any) => Number(hotel.active) === 1)
    : [];

// El buscador de la portada llega aquí con destino, fechas y viajeros en la URL.
const searchQuery = parseSearchQuery(Astro.url.searchParams);
const searchFiltered = hasSearchFilters(searchQuery);
const hoteles = searchQuery.destino
    ? hotelesActivos.filter((hotel: any) => matchesDestino(hotel, searchQuery.destino))
    : hotelesActivos;
const searchQueryString = toSearchString(searchQuery);
const searchInitial = {
    tipo: 'hotel' as const,
    destino: searchQuery.destino,
    entrada: searchQuery.entrada,
    salida: searchQuery.salida,
    adultos: searchQuery.adultos,
    menores: searchQuery.menores,
    edades: searchQuery.edades,
};
const whatsappNoResultsUrl = `https://wa.me/529987141365?text=${encodeURIComponent(
    `Hola, busqué "${searchQuery.destino}" en su sitio de hoteles y no encontré opciones publicadas. ¿Me pueden ayudar?`
)}`;

// Configuramos cuántos mostrar inicialmente
const INITIAL_VISIBLE = 8;
const hotelHeroImage = new URL('/images/banners/hoteles-desktop.jpg', Astro.site ?? 'https://tudestinomx.com').href;

const hotelListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: hoteles.slice(0, 20).map((hotel: any, index: number) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
            '@type': 'Hotel',
            name: hotel.name,
            url: `https://tudestinomx.com/hotel/${hotel.slug}`,
            image: hotel.images?.principal?.[0]?.url || hotel.imagenes,
            address: {
                '@type': 'PostalAddress',
                addressLocality: hotel.destino || undefined
            },
            aggregateRating: hotel.reviews && hotel.reviews_count ? {
                '@type': 'AggregateRating',
                ratingValue: parseFloat(hotel.reviews),
                reviewCount: hotel.reviews_count,
                bestRating: '5',
                worstRating: '1'
            } : undefined,
            priceRange: hotel.price_range || '$$$'
        }
    })),
    numberOfItems: hoteles.length
};
---

<Layout 
  title="Hoteles en Cancún, Riviera Maya y México | Tu Destino MX"
  description="Encuentra hoteles para tus vacaciones en Cancún, Riviera Maya y otros destinos. Compara opciones y recibe atención personalizada."
  image={hotelHeroImage}
  type="website"
>
    <Header/>

    {!catalogUnavailable && (
        <script type="application/ld+json" set:html={JSON.stringify(hotelListSchema)} />
    )}

    <Content>
        <HeroBanner
                title="Nuestros Hoteles"
                imageSrc="/images/banners/hoteles-desktop.jpg"
                mobileImageSrc="/images/banners/hoteles-mobile.jpg"
                altText="Resort tropical con alberca infinita frente al mar Caribe"
        />

        <div class="container mx-auto py-12 px-4">

            <div class="mb-12 text-center">
                <p class="text-xl font-bold text-purple-800 mb-2">Hoteles para cada tipo de viaje</p>
                <h2 class="text-3xl font-extrabold text-gray-800">Encuentra hospedaje en tus destinos favoritos</h2>
                <p class="mx-auto mt-4 max-w-3xl leading-7 text-gray-600">Explora opciones de hospedaje en México y el Caribe. Si necesitas comparar ubicación, categoría, amenidades o fechas, nuestro equipo puede ayudarte a elegir.</p>
            </div>

            {searchFiltered && <SearchResultsSkeleton label="Buscando tus próximas vacaciones" />}

            <div data-search-results class={searchFiltered ? 'hidden' : undefined}>
            {!catalogUnavailable && searchFiltered && (
                    <div>
                        <SearchSummary query={searchQuery} tipo="hotel" total={hoteles.length} filtrado={Boolean(searchQuery.destino)} />
                        <SearchEditor client:load initial={searchInitial} />
                    </div>
            )}

            {catalogUnavailable ? (
                    <div class="text-center py-20">
                        <p class="text-gray-700 font-semibold">El catálogo de hoteles no está disponible temporalmente.</p>
                        <p class="text-gray-500 mt-2">Intenta nuevamente más tarde o contáctanos para ayudarte a encontrar hospedaje.</p>
                    </div>
            ) : hoteles.length > 0 ? (
                    <div class="flex flex-col items-center">
                        <MobileRail class="md:grid-cols-2 lg:grid-cols-4 md:gap-8 w-full">
                            {hoteles.map((hotel: any, index: number) => (
                                    <div class={`hotel-card ${index >= INITIAL_VISIBLE ? 'md:hidden' : ''}`} data-extra={index >= INITIAL_VISIBLE ? '' : undefined}>
                                        <Card
                                                title={hotel.name || hotel.title}
                                                slug={hotel.slug}
                                                type="hotel"
                                                destino={hotel.destino}
                                                photo={hotel.images || hotel.imagenes}
                                                query={searchQueryString}
                                        />
                                    </div>
                            ))}
                        </MobileRail>

                        {hoteles.length > INITIAL_VISIBLE && (
                                <button
                                        id="load-more-btn"
                                        class="hidden md:block mt-12 px-8 py-3 bg-purple-800 text-white font-bold rounded-full hover:bg-purple-900 transition-colors shadow-lg"
                                >
                                    Ver más hoteles
                                </button>
                        )}
                    </div>
            ) : (
                    <div class="mx-auto max-w-2xl py-16 text-center">
                        {searchFiltered ? (
                            <>
                                <p class="text-xl font-extrabold text-gray-800">
                                    {searchQuery.destino ? `No encontramos hoteles para "${searchQuery.destino}"` : 'No encontramos hoteles con esa búsqueda'}
                                </p>
                                <p class="mt-3 leading-7 text-gray-600">
                                    Revisa la ortografía o prueba con otro destino. También puedes escribirnos y te ayudamos a encontrar opciones con tus fechas.
                                </p>
                                <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                                    <a href="/hoteles" class="rounded-full border border-gray-300 px-6 py-3 font-bold text-gray-800 transition hover:border-purple-700">Ver todos los hoteles</a>
                                    <a href={whatsappNoResultsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-emerald-600 px-6 py-3 font-bold text-white transition hover:bg-emerald-700">Escribir a un asesor</a>
                                </div>
                            </>
                        ) : (
                            <p class="text-gray-500 italic">No se encontraron hoteles disponibles en este momento.</p>
                        )}
                    </div>
            )}
            </div>
        </div>
    </Content>

    <Footer/>
</Layout>

<script>
    // En móvil todas las tarjetas están en el carrusel; el botón solo existe en escritorio.
    // En escritorio, "Ver más" muestra el siguiente bloque de 8 quitando md:hidden.
    const btn = document.getElementById('load-more-btn');
    const increment = 8;

    const hiddenCards = () =>
        Array.from(document.querySelectorAll<HTMLElement>('.hotel-card[data-extra]')).filter((card) =>
            card.classList.contains('md:hidden')
        );

    btn?.addEventListener('click', () => {
        hiddenCards()
            .slice(0, increment)
            .forEach((card) => {
                card.classList.remove('md:hidden');
                card.classList.add('animate-fade-in');
            });

        // Si ya no hay más tarjetas ocultas, quitamos el botón
        if (hiddenCards().length === 0 && btn) {
            btn.style.display = 'none';
        }
    });
</script>

<style>
    /* Animación suave para cuando aparecen los nuevos hoteles */
    .animate-fade-in {
        animation: fadeIn 0.5s ease forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
