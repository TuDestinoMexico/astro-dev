---
import Layout from "../layouts/Layout.astro";
import Content from "../components/layout/Content.astro";
import { db } from "../lib/firebase";
import { collection, doc, getDoc, getDocs, query, orderBy } from "firebase/firestore";
import { Icon } from "astro-icon/components";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MemberCard from "../components/ui/team/MemberCard.astro";

interface TeamMember {
    id: string;
    activo?: boolean;
    posicion?: number;
    foto?: string;
    nombre?: string;
    puesto?: string;
}

let team: TeamMember[] = [];
let teamLoadFailed = false;
let whatsappNumber = "";

try {
    const [teamSnapshot, generalSnapshot] = await Promise.all([
        getDocs(query(collection(db, "equipo"), orderBy("posicion", "asc"))),
        getDoc(doc(db, "config", "general")),
    ]);

    team = teamSnapshot.docs
        .map((memberDoc) => ({ id: memberDoc.id, ...(memberDoc.data() as Omit<TeamMember, "id">) }))
        .filter((member) => member.activo !== false);

    const configuredWhatsapp = generalSnapshot.data()?.whatsappGlobal;
    whatsappNumber = typeof configuredWhatsapp === "string" ? configuredWhatsapp.trim() : "";
} catch (error) {
    console.warn("[nosotros] No se pudo cargar el contenido dinámico.", error);
    teamLoadFailed = true;
}

const whatsappHref = whatsappNumber
    ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hola, quiero planear mis próximas vacaciones con Tu Destino México.")}`
    : "";
---

<Layout
    title="Conoce a nuestros Vacation Planners | Tu Destino México"
    description="Conoce al equipo de Vacation Planners que convierte tus ideas de viaje en experiencias memorables."
    image="https://storage.googleapis.com/tudestinomx_bucket/assets/promos/destinos/riviera-maya.png"
>
    <Content>
        <Header />

        <main class="space-y-20 pb-16 pt-6 md:space-y-28 md:pt-10">
            <section class="relative isolate overflow-hidden rounded-[2rem] bg-brand-ink text-white shadow-2xl md:min-h-[34rem] md:rounded-[3rem]">
                <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_78%_15%,rgba(248,142,42,0.28),transparent_30%),linear-gradient(120deg,#111827_0%,#172554_58%,#0f172a_100%)]"></div>
                <div class="absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full border border-white/10 md:h-96 md:w-96"></div>
                <div class="grid min-h-[34rem] items-end md:grid-cols-[0.9fr_1.1fr] md:items-stretch">
                    <div class="flex flex-col justify-center px-6 pb-10 pt-12 md:px-14 md:py-16 lg:px-20">
                        <div class="mb-6 flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.24em] text-brand-primary">
                            <span class="h-px w-8 bg-brand-primary"></span>
                            Tu Destino México · Vacation Planners
                        </div>
                        <h1 class="max-w-xl text-4xl font-black uppercase leading-[0.93] tracking-[-0.06em] sm:text-6xl md:text-7xl">
                            El viaje comienza mucho antes de llegar.
                        </h1>
                        <p class="mt-6 max-w-lg text-base leading-7 text-white/70 md:text-lg">
                            Escuchamos lo que imaginas, cuidamos lo que importa y convertimos tus próximas vacaciones en una experiencia que se siente verdaderamente tuya.
                        </p>
                        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
                            <a href="#equipo" class="inline-flex items-center justify-center gap-2 rounded-card bg-brand-primary px-5 py-3.5 text-xs font-black uppercase tracking-[0.12em] text-white shadow-lg shadow-brand-primary/20 transition hover:-translate-y-0.5 hover:bg-brand-primary-hover focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 focus:ring-offset-brand-ink">
                                Conoce al equipo
                                <Icon name="lucide:arrow-down-right" size="16" aria-hidden="true" />
                            </a>
                            {whatsappHref && (
                                <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-2 py-3 text-xs font-black uppercase tracking-[0.12em] text-white/70 transition hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-primary">
                                    Habla con un planner
                                    <Icon name="lucide:arrow-up-right" size="16" aria-hidden="true" />
                                </a>
                            )}
                        </div>
                    </div>
                    <div class="relative min-h-[19rem] overflow-hidden md:min-h-0">
                        <img
                            src="https://storage.googleapis.com/tudestinomx_bucket/assets/promos/destinos/riviera-maya.png"
                            alt="Paisaje de Riviera Maya"
                            class="absolute inset-0 h-full w-full object-cover"
                            width="1200"
                            height="900"
                            loading="eager"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-brand-ink via-brand-ink/10 to-transparent md:bg-gradient-to-r md:from-brand-ink/80 md:via-transparent md:to-transparent"></div>
                        <div class="absolute bottom-5 left-5 flex items-center gap-3 rounded-pill border border-white/20 bg-brand-ink/30 px-4 py-2 text-[9px] font-black uppercase tracking-[0.2em] text-white backdrop-blur-md md:bottom-10 md:left-10">
                            <span class="h-1.5 w-1.5 rounded-full bg-brand-primary"></span>
                            Viajes con intención
                        </div>
                    </div>
                </div>
            </section>

            <section class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start md:gap-20">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-[0.24em] text-brand-primary">Nuestra manera de viajar</p>
                    <h2 class="mt-4 max-w-md text-3xl font-black uppercase leading-tight tracking-[-0.04em] text-brand-ink md:text-5xl">
                        No reservamos habitaciones. Diseñamos momentos.
                    </h2>
                </div>
                <div class="max-w-2xl space-y-5 text-base leading-7 text-brand-muted md:text-lg">
                    <p>Creemos que cada viajero tiene una forma distinta de desconectarse, celebrar y descubrir. Por eso empezamos con una conversación, no con un catálogo.</p>
                    <p>Tu Vacation Planner está para ayudarte a elegir con claridad, anticipar los detalles y acompañarte hasta que el viaje deje de ser una idea y se convierta en una historia que quieras contar.</p>
                </div>
            </section>

            <section class="grid gap-4 md:grid-cols-3">
                <article class="rounded-card border border-brand-line bg-brand-surface p-6 md:p-8">
                    <span class="text-3xl font-black text-brand-primary">01</span>
                    <h2 class="mt-8 text-lg font-black uppercase tracking-tight text-brand-ink">Te escuchamos</h2>
                    <p class="mt-3 text-sm leading-6 text-brand-muted">Entendemos qué buscas antes de recomendarte dónde vivirlo.</p>
                </article>
                <article class="rounded-card border border-brand-line bg-brand-surface p-6 md:p-8">
                    <span class="text-3xl font-black text-brand-primary">02</span>
                    <h2 class="mt-8 text-lg font-black uppercase tracking-tight text-brand-ink">Diseñamos contigo</h2>
                    <p class="mt-3 text-sm leading-6 text-brand-muted">Combinamos destinos, hoteles y experiencias según tu manera de viajar.</p>
                </article>
                <article class="rounded-card border border-brand-line bg-brand-surface p-6 md:p-8">
                    <span class="text-3xl font-black text-brand-primary">03</span>
                    <h2 class="mt-8 text-lg font-black uppercase tracking-tight text-brand-ink">Te acompañamos</h2>
                    <p class="mt-3 text-sm leading-6 text-brand-muted">Seguimos cerca para que disfrutes el camino con más tranquilidad.</p>
                </article>
            </section>

            <section id="equipo" class="scroll-mt-24">
                <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.24em] text-brand-primary">Las personas detrás del viaje</p>
                        <h2 class="mt-3 text-3xl font-black uppercase tracking-[-0.04em] text-brand-ink md:text-5xl">Conoce a tus planners</h2>
                    </div>
                    <p class="max-w-sm text-sm leading-6 text-brand-muted md:text-right">Personas reales, recomendaciones honestas y una obsesión saludable por los detalles.</p>
                </div>

                {team.length > 0 ? (
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                        {team.map((member) => <MemberCard member={member} />)}
                    </div>
                ) : (
                    <div class="rounded-card border border-dashed border-brand-line bg-brand-surface px-6 py-12 text-center">
                        <Icon name="lucide:users-round" size="32" class="mx-auto text-brand-primary" aria-hidden="true" />
                        <p class="mt-4 text-sm font-bold text-brand-ink">{teamLoadFailed ? "Nuestro equipo estará disponible en un momento." : "Estamos preparando a nuestro equipo."}</p>
                        <p class="mt-2 text-xs text-brand-muted">Mientras tanto, podemos ayudarte a imaginar tu próximo destino.</p>
                    </div>
                )}
            </section>

            <section class="relative overflow-hidden rounded-[2rem] bg-brand-primary px-6 py-12 text-white md:rounded-[3rem] md:px-14 md:py-16">
                <div class="absolute -right-8 -top-16 h-56 w-56 rounded-full border border-white/20"></div>
                <div class="relative z-10 flex flex-col justify-between gap-8 md:flex-row md:items-end">
                    <div class="max-w-2xl">
                        <p class="text-[10px] font-black uppercase tracking-[0.24em] text-white/70">Tu próximo capítulo</p>
                        <h2 class="mt-4 text-3xl font-black uppercase leading-tight tracking-[-0.04em] md:text-5xl">Cuéntanos qué viaje estás imaginando.</h2>
                    </div>
                    {whatsappHref && (
                        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-card bg-white px-5 py-4 text-xs font-black uppercase tracking-[0.12em] text-brand-primary transition hover:-translate-y-0.5 hover:bg-brand-ink hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-brand-primary">
                            Hablar por WhatsApp
                            <Icon name="simple-icons:whatsapp" size="17" aria-hidden="true" />
                        </a>
                    )}
                </div>
            </section>
        </main>
    </Content>
    <Footer />
</Layout>
