---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Content from '../../components/layout/Content.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import DestinationCatalogSection from '../../components/ui/destinations/DestinationCatalogSection.astro';
import { destinations } from '../../data/destinations';
import { fetchDestinationCatalog } from '../../lib/destinations';

const { slug } = Astro.params;
const destination = destinations.find((item) => item.slug === slug);

if (!destination) {
    return Astro.redirect('/404', 404);
}

const catalog = await fetchDestinationCatalog(destination);
if (catalog.unavailable) {
    Astro.response.headers.set('Retry-After', '3600');
}

const destinationSchema = {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: destination.name,
    description: destination.description,
    url: `https://tudestinomx.com/destinos/${destination.slug}/`,
    image: destination.image,
    containedInPlace: {
        '@type': 'Country',
        name: destination.country
    }
};

const title = `Viajes a ${destination.name}: Hoteles, Tours y Vacaciones | Tu Destino MX`;
const description = `Planea tu viaje a ${destination.name}. Descubre hoteles, tours y experiencias, y recibe asesoría personalizada de Tu Destino México.`;
---

<Layout title={title} description={description} image={destination.image} type="website" noindex={catalog.unavailable}>
    <Header />
    <script type="application/ld+json" set:html={JSON.stringify(destinationSchema)} />

    <Content>
        <main class="space-y-16 pb-16 pt-6 md:space-y-20 md:pt-10">
            <Breadcrumbs items={[
                { label: 'Inicio', href: '/' },
                { label: 'Destinos', href: '/destinos' },
                { label: destination.name }
            ]} />

            <section class="grid gap-8 overflow-hidden rounded-[2rem] bg-slate-950 text-white md:grid-cols-[1.05fr_0.95fr] md:items-stretch">
                <div class="flex flex-col justify-center p-7 md:p-12">
                    <p class="text-xs font-black uppercase tracking-[0.24em] text-indigo-300">{destination.country} · Tu Destino México</p>
                    <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">Viajes a {destination.name}</h1>
                    <p class="mt-6 max-w-2xl text-base leading-7 text-white/75">{destination.description}</p>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="#hoteles" class="rounded-xl bg-indigo-500 px-5 py-3 text-sm font-black text-white transition hover:bg-indigo-400">Ver hoteles</a>
                        <a href="#tours" class="rounded-xl border border-white/30 px-5 py-3 text-sm font-black text-white transition hover:bg-white/10">Ver tours</a>
                    </div>
                </div>
                <img src={destination.image} alt={destination.alt} width="900" height="650" loading="eager" fetchpriority="high" class="h-full min-h-72 w-full object-cover" />
            </section>

            <section aria-labelledby="highlights-heading" class="grid gap-8 md:grid-cols-[0.8fr_1.2fr]">
                <div>
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600">Antes de reservar</p>
                    <h2 id="highlights-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-900">Planea mejor tu visita</h2>
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                    {destination.highlights.map((highlight) => (
                        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-sm font-bold leading-6 text-slate-700">{highlight}</p>
                        </article>
                    ))}
                </div>
            </section>

            <DestinationCatalogSection destination={destination} type="hotel" items={catalog.hotels} />
            <DestinationCatalogSection destination={destination} type="tour" items={catalog.tours} />

            <section class="rounded-3xl border border-indigo-100 bg-indigo-50 p-7 md:p-10" aria-labelledby="planning-heading">
                <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-600">Asesoría personalizada</p>
                        <h2 id="planning-heading" class="mt-2 text-3xl font-black tracking-tight text-slate-900">¿Quieres cotizar tu viaje a {destination.name}?</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">La mejor fecha y combinación de servicios dependen de tu presupuesto, duración y tipo de viaje. Nuestro equipo puede ayudarte a compararlas.</p>
                    </div>
                    <a href={destination.promoUrl || 'https://wa.me/529989806611'} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl bg-green-600 px-6 py-4 text-sm font-black text-white transition hover:bg-green-700">Solicitar cotización</a>
                </div>
            </section>

            <section aria-labelledby="season-heading" class="max-w-3xl">
                <h2 id="season-heading" class="text-2xl font-black text-slate-900">Mejor época para viajar a {destination.name}</h2>
                <p class="mt-3 leading-7 text-slate-600">{destination.bestTime}</p>
            </section>
        </main>
    </Content>
    <Footer />
</Layout>
