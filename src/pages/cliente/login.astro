---
import LayoutClient from '../../layouts/LayoutClient.astro';
import GoogleLoginButton from '../../components/ui/client/GoogleLoginButton';
---

<LayoutClient title="Iniciar Sesión | Tu Destino MX">
    <main class="w-full min-h-screen bg-slate-50 flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white p-8 rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/50 text-center">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-purple-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight mb-2">Área de Clientes</h2>
            <p class="text-sm text-slate-500 mb-6">Inicia sesión para consultar tus reservas.</p>
            <GoogleLoginButton client:only="react" />
        </div>
    </main>
</LayoutClient>
