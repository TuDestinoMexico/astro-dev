---
import Layout from '../../layouts/Layout.astro';
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { Icon } from 'astro-icon/components';
import Gallery from '../../components/ui/hotel/Gallery.astro';
import BookingCalendar from '../../components/ui/BookingCalendar';
import HotelTabs from '../../components/ui/hotel/HotelTabs';
import FavoriteButton from '../../components/ui/FavoriteButton.jsx';

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect('/404');
}

const token = import.meta.env.VITE_API_TOKEN;

// Fetch al endpoint de tours
const response = await fetch(`https://api.tudestinomx.com/api/tour/slug/${slug}`, {
    headers: {
        'Authorization': `Bearer ${token}`,
        'Accept': 'application/json'
    }
});

if (!response.ok) {
    return Astro.redirect('/404');
}

const data = await response.json();
const tour = data.data || data;

const amenities = tour.amenities_list || [];
const coordinates = tour.google_maps || [];
const address = tour.address || tour.destino || "Ubicación no disponible";

const rawImages = tour.images || {};
const allImages = [
    ...(rawImages.principal || []),
    ...(rawImages.secundaria || []),
    ...(rawImages.adicional || [])
];

const principalImage = rawImages.principal && rawImages.principal.length > 0
    ? rawImages.principal[0].url
    : (allImages.length > 0 && allImages[0].url ? allImages[0].url : '');

const recentlyViewedData = {
    id: `tour-${slug}`,
    type: "tour",
    title: tour.name,
    location: address,
    image: principalImage,
    url: `/tour/${slug}`
};

const tourSchema = {
    '@context': 'https://schema.org',
    '@type': ['TouristAttraction', 'Event'],
    name: tour.name,
    description: tour.description,
    url: `https://tudestinomx.com/tour/${slug}`,
    image: principalImage ? [principalImage] : undefined,
    location: {
        '@type': 'Place',
        name: tour.name,
        address: {
            '@type': 'PostalAddress',
            streetAddress: address,
            addressLocality: tour.destino || 'Cancún',
            addressRegion: 'Quintana Roo',
            addressCountry: 'MX'
        },
        geo: coordinates.length >= 2 ? {
            '@type': 'GeoCoordinates',
            latitude: parseFloat(coordinates[0]),
            longitude: parseFloat(coordinates[1])
        } : undefined
    },
    organizer: {
        '@type': 'Organization',
        name: 'Tu Destino México',
        url: 'https://tudestinomx.com',
        telephone: '+52-998-980-6611'
    },
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    startDate: tour.start_date || new Date().toISOString(),
    endDate: tour.end_date || new Date(Date.now() + 86400000).toISOString(),
    offers: tour.price ? {
        '@type': 'Offer',
        name: tour.name,
        description: tour.description,
        url: `https://tudestinomx.com/tour/${slug}`,
        priceCurrency: 'MXN',
        price: tour.price,
        availability: 'https://schema.org/InStock',
        validFrom: new Date().toISOString(),
        seller: {
            '@type': 'Organization',
            name: 'Tu Destino México'
        }
    } : undefined,
    aggregateRating: tour.reviews && tour.reviews_count ? {
        '@type': 'AggregateRating',
        ratingValue: parseFloat(tour.reviews),
        reviewCount: tour.reviews_count,
        bestRating: '5',
        worstRating: '1'
    } : undefined,
    includes: tour.includes ? tour.includes : undefined,
    audience: {
        '@type': 'Audience',
        audienceType: 'Turistas, Familias, Parejas'
    }
};
---

<Layout 
  title={tour.name || "Detalle de Tour"} 
  description={tour.description || "Detalle de Tour"}
  image={principalImage}
  type="website"
>
    <Header/>

    <script type="application/ld+json" set:html={JSON.stringify(tourSchema)} />

    <main class="container mx-auto my-8 space-y-8 px-5 xl:px-0">

        <div class="space-y-4">
            <div class="flex items-center justify-between gap-4 flex-wrap">
                <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">
                    {tour.name}
                </h1>
                <FavoriteButton
                    client:idle
                    tipo="tour"
                    slug={slug}
                    nombre={tour.name}
                    imagen={principalImage}
                    destino={tour.destino}
                />
            </div>

            <div class="flex flex-wrap items-center gap-y-3 gap-x-6 text-sm md:text-base">
                <div class="flex items-center gap-1.5 bg-yellow-50 px-3 py-1 rounded-full border border-yellow-200">
                    <Icon class="text-yellow-500" size={18} name="fa7-solid:star"/>
                    <span class="font-bold text-yellow-700">{tour.reviews ?? '4.8'}</span>
                </div>

                <div class="flex items-start gap-2 flex-1 min-w-0 text-slate-600 font-medium">
                    <Icon class="text-red-500 mt-0.5 shrink-0" size={20} name="fa7-solid:location-dot"/>
                    <p class="truncate md:whitespace-normal">{address}</p>
                </div>
            </div>

            <Gallery images={allImages} hotelName={tour.name} />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white border border-slate-100 shadow-sm rounded-2xl overflow-hidden">
                    <HotelTabs
                            client:load
                            description={tour.description}
                            coordinates={coordinates}
                            address={address}
                            amenities={amenities}
                    />
                </div>

                {tour.includes && (
                        <div class="bg-slate-50 border border-slate-100 p-6 rounded-2xl">
                            <h3 class="text-xl font-bold text-slate-800 mb-4">¿Qué incluye esta experiencia?</h3>
                            <div class="prose prose-slate max-w-none text-slate-600" set:html={tour.includes}></div>
                        </div>
                )}
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white border border-slate-200 p-6 rounded-3xl sticky top-24 shadow-xl shadow-slate-200/50">
                    <div class="flex items-center gap-2 mb-6 border-b pb-4 border-slate-100">
                        <Icon name="fa7-solid:calendar-check" size={24} class="text-purple-600"/>
                        <h2 class="text-xl font-black text-slate-800 tracking-tight">Reserva tu aventura</h2>
                    </div>

                    <BookingCalendar
                            client:only="react"
                            hotelName={tour.name}
                            isSingleDate={true}
                    />

                    <div class="mt-6 pt-6 border-t border-slate-100">
                        <p class="text-[10px] text-center text-slate-400 font-bold uppercase tracking-widest leading-relaxed">
                            Al confirmar, te contactaremos por WhatsApp para finalizar tu reservación y coordinar detalles.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <Footer/>
</Layout>

<script define:vars={{ recentlyViewedData }}>
    if (typeof window !== 'undefined' && recentlyViewedData && recentlyViewedData.id) {
        try {
            const currentStorage = localStorage.getItem('tdmx_recently_viewed');
            let items = currentStorage ? JSON.parse(currentStorage) : [];

            items = items.filter(item => item.id !== recentlyViewedData.id);

            items.unshift(recentlyViewedData);

            localStorage.setItem('tdmx_recently_viewed', JSON.stringify(items.slice(0, 4)));
        } catch (error) {
            console.error("Error guardando historial de tours:", error);
        }
    }
</script>
