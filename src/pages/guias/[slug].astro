---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Content from '../../components/layout/Content.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getGuide } from '../../data/guides';

const guide = Astro.params.slug ? getGuide(Astro.params.slug) : undefined;
if (!guide) return Astro.redirect('/404', 404);
const sectionId = (heading: string) => `${guide.slug}-${heading.toLowerCase().replace(/[^a-z0-9áéíóúüñ]+/gi, '-').replace(/^-|-$/g, '')}`;

const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    image: [guide.image],
    datePublished: guide.publishedAt,
    dateModified: guide.updatedAt,
    author: {
        '@type': 'Organization',
        name: 'Tu Destino México',
        url: 'https://tudestinomx.com'
    },
    publisher: {
        '@type': 'Organization',
        name: 'Tu Destino México',
        url: 'https://tudestinomx.com',
        logo: {
            '@type': 'ImageObject',
            url: 'https://storage.googleapis.com/tudestinomx_bucket/assets/test/tdmx_logo_mundial.png'
        }
    },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://tudestinomx.com/guias/${guide.slug}/`
    }
};
---

<Layout title={guide.metaTitle} description={guide.description} image={guide.image} type="article">
    <Header />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <Content>
        <main class="pb-16 pt-6 md:pt-10">
            <Breadcrumbs items={[
                { label: 'Inicio', href: '/' },
                { label: 'Guías de viaje', href: '/guias/' },
                { label: guide.title }
            ]} />

            <article class="mx-auto mt-10 max-w-4xl">
                <header>
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-indigo-600">{guide.category}</p>
                    <h1 class="mt-4 text-4xl font-black leading-tight tracking-tight text-slate-900 md:text-6xl">{guide.title}</h1>
                    <p class="mt-6 text-xl leading-8 text-slate-600">{guide.excerpt}</p>
                    <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
                        <span>Por Tu Destino México</span>
                        <time datetime={guide.updatedAt}>Actualizado el {guide.updatedAt}</time>
                    </div>
                </header>

                <img src={guide.image} alt={guide.imageAlt} width="1200" height="800" loading="eager" fetchpriority="high" class="mt-10 aspect-[3/2] w-full rounded-3xl object-cover" />

                <div class="mt-10 space-y-10">
                    {guide.sections.map((section) => (
                        <section aria-labelledby={sectionId(section.heading)}>
                            <h2 id={sectionId(section.heading)} class="text-3xl font-black tracking-tight text-slate-900">{section.heading}</h2>
                            <div class="mt-4 space-y-4 text-base leading-8 text-slate-700">
                                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                            </div>
                        </section>
                    ))}
                </div>

                <section class="mt-12 rounded-3xl border border-indigo-100 bg-indigo-50 p-7 md:p-10" aria-labelledby="guide-action-heading">
                    <h2 id="guide-action-heading" class="text-3xl font-black tracking-tight text-slate-900">Continúa planeando tu viaje</h2>
                    <p class="mt-3 leading-7 text-slate-600">Consulta opciones relacionadas y pide una recomendación según tus fechas, presupuesto y acompañantes.</p>
                    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
                        {guide.relatedLinks.map((link) => <a href={link.href} class="font-bold text-indigo-700 hover:underline">{link.label}</a>)}
                    </div>
                    <a href="https://wa.me/529989806611" target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex rounded-xl bg-green-600 px-5 py-3 text-sm font-black text-white hover:bg-green-700">Solicitar asesoría por WhatsApp</a>
                </section>
            </article>
        </main>
    </Content>
    <Footer />
</Layout>
