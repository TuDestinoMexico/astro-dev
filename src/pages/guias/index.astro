---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Content from '../../components/layout/Content.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { guides } from '../../data/guides';
---

<Layout
    title="Guías de Viaje: Destinos, Hoteles y Tours | Tu Destino MX"
    description="Consejos y guías para planear viajes a Cancún, Riviera Maya, Los Cabos y otros destinos. Compara hoteles, tours y experiencias con asesoría personalizada."
>
    <Header />
    <Content>
        <main class="space-y-12 pb-16 pt-6 md:pt-10">
            <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Guías de viaje' }]} />

            <header class="max-w-3xl">
                <p class="text-xs font-black uppercase tracking-[0.24em] text-indigo-600">Información para decidir mejor</p>
                <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-900 md:text-6xl">Guías para planear tu próximo viaje</h1>
                <p class="mt-5 text-lg leading-8 text-slate-600">Encuentra recomendaciones prácticas para elegir destino, hotel y experiencias. Cuando estés listo, nuestro equipo puede ayudarte a convertir la idea en una cotización.</p>
            </header>

            <section aria-labelledby="guides-heading">
                <h2 id="guides-heading" class="sr-only">Todas las guías de viaje</h2>
                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {guides.map((guide) => (
                        <article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                            <a href={`/guias/${guide.slug}/`} class="block overflow-hidden">
                                <img src={guide.image} alt={guide.imageAlt} width="900" height="650" loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105" />
                            </a>
                            <div class="flex flex-1 flex-col p-6">
                                <p class="text-xs font-black uppercase tracking-[0.18em] text-indigo-600">{guide.category}</p>
                                <h2 class="mt-3 text-2xl font-black leading-tight text-slate-900"><a href={`/guias/${guide.slug}/`} class="hover:text-indigo-700">{guide.title}</a></h2>
                                <p class="mt-4 flex-1 text-sm leading-6 text-slate-600">{guide.excerpt}</p>
                                <a href={`/guias/${guide.slug}/`} class="mt-6 font-bold text-indigo-700 hover:underline">Leer la guía</a>
                            </div>
                        </article>
                    ))}
                </div>
            </section>

            <section class="rounded-3xl border border-indigo-100 bg-indigo-50 p-7 md:p-10" aria-labelledby="guide-cta-heading">
                <h2 id="guide-cta-heading" class="text-3xl font-black tracking-tight text-slate-900">¿Ya tienes destino?</h2>
                <p class="mt-3 max-w-2xl leading-7 text-slate-600">Explora hoteles, tours y experiencias disponibles o solicita una recomendación para tus fechas.</p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="/destinos/" class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-black text-white hover:bg-indigo-700">Explorar destinos</a>
                    <a href="/hoteles/" class="rounded-xl border border-indigo-200 bg-white px-5 py-3 text-sm font-black text-indigo-700 hover:bg-indigo-100">Ver hoteles</a>
                    <a href="/tours/" class="rounded-xl border border-indigo-200 bg-white px-5 py-3 text-sm font-black text-indigo-700 hover:bg-indigo-100">Ver tours</a>
                </div>
            </section>
        </main>
    </Content>
    <Footer />
</Layout>
