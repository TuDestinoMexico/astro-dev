---
import Layout from '../../layouts/Layout.astro';
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { Icon } from 'astro-icon/components';
import Gallery from '../../components/ui/hotel/Gallery.astro';
import BookingCalendar from '../../components/ui/BookingCalendar';
import HotelTabs from '../../components/ui/hotel/HotelTabs';
import FavoriteButton from '../../components/ui/FavoriteButton.jsx';

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect('/404');
}

const token = import.meta.env.VITE_API_TOKEN;

const response = await fetch(`https://api.tudestinomx.com/api/hotel/slug/${slug}`, {
    headers: {
        'Authorization': `Bearer ${token}`,
        'Accept': 'application/json'
    }
});

if (!response.ok) {
    return Astro.redirect('/404');
}

const data = await response.json();
const hotel = data.data || data;

if (Number(hotel.active) === 0) {
    return Astro.redirect('/404');
}

const amenities = hotel.amenities_list || [];
const coordinates = hotel.google_maps || [];

const rawImages = hotel.images || {};
const allImages = [
    ...(rawImages.principal || []),
    ...(rawImages.secundaria || []),
    ...(rawImages.adicional || [])
];

const principalImage = rawImages.principal && rawImages.principal.length > 0
    ? rawImages.principal[0].url
    : (allImages.length > 0 && allImages[0].url ? allImages[0].url : '');

const recentlyViewedData = {
    id: slug,
    type: "hotel",
    title: hotel.name,
    location: hotel.address,
    image: principalImage,
    url: `/hotel/${slug}`
};

const hotelSchema = {
    '@context': 'https://schema.org',
    '@type': ['LodgingBusiness', 'Hotel'],
    name: hotel.name,
    description: hotel.description,
    url: `https://tudestinomx.com/hotel/${slug}`,
    image: principalImage ? [principalImage] : undefined,
    address: {
        '@type': 'PostalAddress',
        streetAddress: hotel.address,
        addressLocality: hotel.destino || 'Cancún',
        addressRegion: 'Quintana Roo',
        addressCountry: 'MX'
    },
    geo: coordinates.length >= 2 ? {
        '@type': 'GeoCoordinates',
        latitude: parseFloat(coordinates[0]),
        longitude: parseFloat(coordinates[1])
    } : undefined,
    telephone: hotel.phone || '+52-998-980-6611',
    email: hotel.email,
    starRating: hotel.stars ? {
        '@type': 'Rating',
        ratingValue: hotel.stars,
        bestRating: '5',
        worstRating: '1'
    } : undefined,
    aggregateRating: hotel.reviews && hotel.reviews_count ? {
        '@type': 'AggregateRating',
        ratingValue: parseFloat(hotel.reviews),
        reviewCount: hotel.reviews_count,
        bestRating: '5',
        worstRating: '1'
    } : undefined,
    amenityFeature: amenities.map((a: string) => ({
        '@type': 'LocationFeatureSpecification',
        name: a,
        value: true
    })),
    checkInTime: '15:00',
    checkOutTime: '12:00',
    currenciesAccepted: 'MXN',
    paymentAccepted: 'Cash, Credit Card, Transfer, OXXO, SPEI',
    priceRange: hotel.price_range || '$$$',
    makesOffer: hotel.price ? {
        '@type': 'Offer',
        name: `${hotel.name} - Habitación Estándar`,
        description: hotel.description,
        url: `https://tudestinomx.com/hotel/${slug}`,
        priceCurrency: 'MXN',
        price: hotel.price,
        availability: 'https://schema.org/InStock',
        seller: {
            '@type': 'Organization',
            name: 'Tu Destino México'
        }
    } : undefined
};
---

<Layout 
  title={hotel.name || "Detalle de Hotel"} 
  description={hotel.description || "Detalle de Hotel"}
  image={principalImage}
  type="website"
>
    <Header/>

    <script type="application/ld+json" set:html={JSON.stringify(hotelSchema)} />

    <main class="container mx-auto my-8 space-y-8 px-5 xl:px-0">

        <div class="space-y-4">
            <div class="flex items-center justify-between gap-4 flex-wrap">
                <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">
                    {hotel.name}
                </h1>
                <FavoriteButton
                    client:idle
                    tipo="hotel"
                    slug={slug}
                    nombre={hotel.name}
                    imagen={principalImage}
                    destino={hotel.destino}
                />
            </div>

            <div class="flex flex-wrap items-center gap-y-3 gap-x-6 text-sm md:text-base">
                <div class="flex items-center gap-1.5 bg-yellow-50 px-3 py-1 rounded-full border border-yellow-200">
                    <Icon class="text-yellow-500" size="18" name="fa7-solid:star"/>
                    <span class="font-bold text-yellow-700">{hotel.reviews ?? 'N/A'}</span>
                </div>

                <div class="flex items-start gap-2 flex-1 min-w-0 text-slate-600 font-medium">
                    <Icon class="text-red-500 mt-0.5 flex-shrink-0" size="20" name="fa7-solid:location-dot"/>
                    <p class="truncate md:whitespace-normal">{hotel.address}</p>
                </div>
            </div>

            <Gallery images={allImages} hotelName={hotel.name} />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white border border-slate-100 shadow-sm rounded-2xl overflow-hidden">
                    <HotelTabs
                            client:load
                            description={hotel.description}
                            coordinates={coordinates}
                            address={hotel.address}
                            amenities={amenities}
                    />
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-slate-50 border border-slate-200 p-6 rounded-2xl sticky top-24">
                    <div class="flex items-center gap-2 mb-4">
                        <Icon name="fa7-solid:calendar-check" size="24" class="text-emerald-600"/>
                        <h2 class="text-xl font-bold text-slate-800">Reserva tu estadía</h2>
                    </div>
                    <BookingCalendar client:only="react" hotelName={hotel.name} />
                </div>
            </div>

        </div>
    </main>

    <Footer/>
</Layout>

<script define:vars={{ recentlyViewedData }}>
    if (typeof window !== 'undefined' && recentlyViewedData && recentlyViewedData.id) {
        try {
            const currentStorage = localStorage.getItem('tdmx_recently_viewed');
            let items = currentStorage ? JSON.parse(currentStorage) : [];

            items = items.filter(item => item.id !== recentlyViewedData.id);

            items.unshift(recentlyViewedData);

            localStorage.setItem('tdmx_recently_viewed', JSON.stringify(items.slice(0, 4)));
        } catch (error) {
            console.error("Error guardando historial:", error);
        }
    }
</script>
