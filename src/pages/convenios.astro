---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Content from "../components/layout/Content.astro";

// Fin de la vigencia de las alianzas (hora de Cancún, UTC-5).
const VIGENCIA_FIN = new Date("2026-12-31T23:59:59-05:00");

function formatoRestante(fin: Date, ahora: Date = new Date()): string {
    const minutos = Math.max(0, Math.floor((fin.getTime() - ahora.getTime()) / 60000));
    const dias = Math.floor(minutos / 1440);
    const horas = Math.floor((minutos % 1440) / 60);
    const mins = minutos % 60;
    return `${dias} d ${String(horas).padStart(2, "0")} h ${String(mins).padStart(2, "0")} m`;
}

const alianzasExclusivas = [
    {
        empresa: "Sams Club Afiliados",
        tipo: "Afiliación PLUS / Benefits",
        descripcion: "Con tu Membresía física o digital PLUS o Benefits obtén:",
        beneficios: [
            "15% de descuento",
            "Paquetes a costo preferencia por $18,990"
        ],
        url: "https://www.samsbenefits.com/resultados/detalles/Tu-Destino-M%C3%A9xico/P7562",
        monograma: "bg-orange-500",
        etiqueta: "bg-orange-100 text-orange-800"
    },
    {
        empresa: "Nissan",
        tipo: "Colaborador Corporativo",
        descripcion: "Si eres un colaborador de Grupo Nissan, escapate a unas vacaciones en la playa.",
        url: "https://conveniosnissan.com/c/Tu-Destino-Mexico_12668",
        beneficios: [
            "Paquetes en $13,990",
            "35% de descuento en hoteles",
            "25% en tours y traslados"
        ],
        monograma: "bg-red-600",
        etiqueta: "bg-red-50 text-red-700"
    }
].map((aliado) => ({
    ...aliado,
    inicial: aliado.empresa.charAt(0).toUpperCase(),
    vence: formatoRestante(VIGENCIA_FIN),
    // Separa las cifras para resaltarlas sin cambiar el texto.
    beneficiosPartes: aliado.beneficios.map((beneficio) =>
        beneficio
            .split(/(\$?\d[\d,.]*%?)/)
            .filter(Boolean)
            .map((parte) => ({ texto: parte, destacado: /^\$?\d/.test(parte) }))
    ),
}));

// Tarjetas de carga mientras la página termina de cargar.
const esqueletos = [0, 1];
---

<Layout title="Convenios Corporativos para Viajes | Tu Destino México" description="Conoce los convenios corporativos y beneficios de viaje disponibles con Tu Destino México para colaboradores y afiliados.">
    <Header/>

    <Content>
        <section class="py-10 md:py-14" aria-labelledby="convenios-titulo">

            <header class="mb-10 max-w-3xl md:mb-12">
                <p class="text-xs font-black uppercase tracking-[0.2em] text-purple-700">Alianzas exclusivas</p>
                <h1 id="convenios-titulo" class="mt-2 text-3xl font-extrabold leading-tight text-purple-800 md:text-4xl">
                    Convenios corporativos para viajes
                </h1>
                <h2 class="mt-2 text-lg font-bold text-slate-700 md:text-xl">Beneficios vigentes</h2>
                <p class="mt-3 text-base leading-relaxed text-slate-500 md:text-lg">
                    Aprovecha los beneficios exclusivos que tenemos para ti a través de nuestras alianzas.
                </p>
            </header>

            {/* Skeleton: visible hasta que carga la página. Se oculta con el script de abajo. */}
            <div role="status" aria-live="polite" data-convenios-skeleton>
                <span class="sr-only">Cargando convenios…</span>
                <ul class="grid max-w-4xl gap-6 md:grid-cols-2 md:gap-8" aria-hidden="true">
                    {esqueletos.map(() => (
                        <li>
                            <div class="flex h-full animate-pulse flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm motion-reduce:animate-none md:p-8">
                                <div class="flex items-start gap-4">
                                    <span class="h-14 w-14 shrink-0 rounded-2xl bg-slate-200"></span>
                                    <div class="min-w-0 flex-1 space-y-3">
                                        <span class="block h-5 w-40 rounded-full bg-slate-200"></span>
                                        <span class="block h-6 w-3/4 rounded-md bg-slate-200"></span>
                                    </div>
                                </div>

                                <div class="mt-5 space-y-2">
                                    <span class="block h-3.5 w-full rounded bg-slate-100"></span>
                                    <span class="block h-3.5 w-2/3 rounded bg-slate-100"></span>
                                </div>

                                <div class="mb-8 mt-5 space-y-3">
                                    <span class="block h-4 w-5/6 rounded bg-slate-100"></span>
                                    <span class="block h-4 w-4/6 rounded bg-slate-100"></span>
                                </div>

                                <div class="mt-auto flex flex-col gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:items-center sm:justify-between">
                                    <span class="block h-4 w-32 rounded bg-slate-200"></span>
                                    <span class="block h-12 w-full rounded-xl bg-slate-200 sm:w-40"></span>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>

            {/* Contenido real: oculto hasta que la página termina de cargar. */}
            <div data-convenios-real hidden>
                <ul class="grid max-w-4xl gap-6 md:grid-cols-2 md:gap-8">
                    {alianzasExclusivas.map((aliado) => (
                        <li>
                            <article class="flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 motion-safe:hover:-translate-y-1 hover:shadow-xl md:p-8">

                                <div class="flex items-start gap-4">
                                    <span class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-xl font-black text-white ${aliado.monograma}`} aria-hidden="true">
                                        {aliado.inicial}
                                    </span>
                                    <div class="min-w-0">
                                        <span class={`inline-block rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wider ${aliado.etiqueta}`}>
                                            {aliado.tipo}
                                        </span>
                                        <h3 class="mt-2 text-xl font-bold leading-tight text-slate-900 md:text-2xl">
                                            {aliado.empresa}
                                        </h3>
                                    </div>
                                </div>

                                {aliado.descripcion && (
                                    <p class="mt-5 text-sm leading-relaxed text-slate-600 md:text-base">
                                        {aliado.descripcion}
                                    </p>
                                )}

                                {aliado.beneficiosPartes.length > 0 && (
                                    <ul class="mb-8 mt-5 space-y-3">
                                        {aliado.beneficiosPartes.map((partes) => (
                                            <li class="flex items-start gap-3 text-sm text-slate-700 md:text-base">
                                                <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                                <span>
                                                    {partes.map((parte) => (
                                                        parte.destacado
                                                            ? <strong class="font-extrabold text-purple-800">{parte.texto}</strong>
                                                            : parte.texto
                                                    ))}
                                                </span>
                                            </li>
                                        ))}
                                    </ul>
                                )}

                                <p class="mb-6 inline-flex w-fit items-center gap-2 rounded-full bg-red-50 px-3 py-1.5 text-xs font-black tabular-nums text-red-700 ring-1 ring-red-200">
                                    <span class="sr-only">Vence el 31 de diciembre de 2026. Tiempo restante:</span>
                                    <span class="relative flex h-2 w-2" aria-hidden="true">
                                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-500 opacity-75 motion-reduce:animate-none"></span>
                                        <span class="relative inline-flex h-2 w-2 rounded-full bg-red-600"></span>
                                    </span>
                                    <span aria-hidden="true">Vence en <span data-vence-restante data-vence-fin={VIGENCIA_FIN.toISOString()}>{aliado.vence}</span></span>
                                </p>

                                <div class="mt-auto flex flex-col gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:items-center sm:justify-between">
                                    <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500">
                                        <svg class="h-4 w-4 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5h14a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2H5a2 2 0 01-2-2v-3a2 2 0 000-4V7a2 2 0 012-2z"></path>
                                        </svg>
                                        Cupón disponible
                                    </span>
                                    <a
                                        href={aliado.url}
                                        data-convenio-link
                                        data-empresa={aliado.empresa}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`Ver beneficio de ${aliado.empresa} (se abre en una pestaña nueva)`}
                                        class="inline-flex min-h-12 w-full items-center justify-center whitespace-nowrap rounded-xl bg-slate-900 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-purple-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600 focus-visible:ring-offset-2 sm:w-auto"
                                    >
                                        Ver beneficio
                                    </a>
                                </div>
                            </article>
                        </li>
                    ))}
                </ul>
            </div>

        </section>

        {/* Confirmación antes de salir del sitio. Sin JavaScript, el enlace abre el sitio directamente. */}
        <dialog
            data-convenio-modal
            aria-labelledby="convenio-modal-titulo"
            aria-describedby="convenio-modal-texto"
            class="convenio-modal m-0 mt-auto w-full max-w-none rounded-t-3xl bg-white p-0 text-slate-900 shadow-2xl sm:m-auto sm:max-w-md sm:rounded-3xl"
        >
            <div class="p-6 md:p-8">
                <div class="flex items-start justify-between gap-4">
                    <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-purple-100 text-purple-700" aria-hidden="true">
                        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                        </svg>
                    </span>
                    <button
                        type="button"
                        data-convenio-cerrar
                        aria-label="Cerrar"
                        class="-m-2 rounded-full p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600"
                    >
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <h2 id="convenio-modal-titulo" class="mt-5 text-xl font-bold leading-tight text-slate-900">
                    Te llevaremos al sitio de <span data-convenio-empresa></span>
                </h2>
                <p id="convenio-modal-texto" class="mt-3 text-sm leading-relaxed text-slate-600 md:text-base">
                    El beneficio se consulta en su sitio oficial. Se abrirá en una pestaña nueva.
                </p>

                <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                    <button
                        type="button"
                        data-convenio-cerrar
                        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 px-5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600 focus-visible:ring-offset-2"
                    >
                        Cancelar
                    </button>
                    <a
                        data-convenio-continuar
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-purple-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600 focus-visible:ring-offset-2"
                    >
                        Continuar al sitio
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14m-6-6l6 6-6 6"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </dialog>
    </Content>

    <Footer/>
</Layout>

<style is:global>
    /* Apertura y cierre del modal. Los navegadores sin soporte abren y cierran sin animación. */
    .convenio-modal {
        opacity: 0;
        translate: 0 1.5rem;
        scale: 0.97;
        transition:
            opacity 220ms ease,
            translate 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
            scale 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
            display 320ms allow-discrete,
            overlay 320ms allow-discrete;
    }

    .convenio-modal[open] {
        opacity: 1;
        translate: 0 0;
        scale: 1;
    }

    @starting-style {
        .convenio-modal[open] {
            opacity: 0;
            translate: 0 1.5rem;
            scale: 0.97;
        }
    }

    @media (max-width: 639px) {
        .convenio-modal { translate: 0 100%; }
        .convenio-modal[open] { translate: 0 0; }
        @starting-style {
            .convenio-modal[open] { translate: 0 100%; }
        }
    }

    .convenio-modal::backdrop {
        background: rgb(15 23 42 / 0);
        transition:
            background-color 320ms ease,
            display 320ms allow-discrete,
            overlay 320ms allow-discrete;
    }

    .convenio-modal[open]::backdrop {
        background: rgb(15 23 42 / 0.6);
        backdrop-filter: blur(4px);
    }

    @starting-style {
        .convenio-modal[open]::backdrop {
            background: rgb(15 23 42 / 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .convenio-modal,
        .convenio-modal::backdrop {
            transition: none !important;
        }
    }
</style>

<noscript>
    <style>
        [data-convenios-skeleton] { display: none !important; }
        [data-convenios-real] { display: block !important; }
    </style>
</noscript>

<script>
    // Muestra el skeleton hasta que la página termina de cargar, con un mínimo para evitar parpadeo.
    const MIN_SKELETON_MS = 400;
    const MAX_SKELETON_MS = 8000;

    const skeleton = document.querySelector<HTMLElement>('[data-convenios-skeleton]');
    const real = document.querySelector<HTMLElement>('[data-convenios-real]');
    const startedAt = performance.now();
    let revealed = false;

    const reveal = () => {
        if (revealed) return;
        revealed = true;

        const wait = Math.max(0, MIN_SKELETON_MS - (performance.now() - startedAt));
        window.setTimeout(() => {
            if (skeleton) skeleton.hidden = true;
            if (real) real.hidden = false;
        }, wait);
    };

    if (document.readyState === 'complete') {
        reveal();
    } else {
        window.addEventListener('load', reveal, { once: true });
        // Respaldo: si la carga tarda demasiado, se muestra el contenido de todos modos.
        window.setTimeout(reveal, MAX_SKELETON_MS);
    }

    // Confirmación antes de salir al sitio del aliado.
    const modal = document.querySelector<HTMLDialogElement>('[data-convenio-modal]');
    const modalEmpresa = modal?.querySelector<HTMLElement>('[data-convenio-empresa]');
    const modalContinuar = modal?.querySelector<HTMLAnchorElement>('[data-convenio-continuar]');

    if (modal && modalEmpresa && modalContinuar) {
        document.querySelectorAll<HTMLAnchorElement>('[data-convenio-link]').forEach((link) => {
            link.addEventListener('click', (event) => {
                // Mantiene el comportamiento nativo para abrir en pestaña nueva con teclas o clic central.
                if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

                event.preventDefault();
                modalEmpresa.textContent = link.dataset.empresa ?? '';
                modalContinuar.href = link.href;
                modal.showModal();
            });
        });

        modal.querySelectorAll('[data-convenio-cerrar]').forEach((boton) => {
            boton.addEventListener('click', () => modal.close());
        });

        // Clic fuera del contenido (sobre el fondo) cierra el modal.
        modal.addEventListener('click', (event) => {
            if (event.target === modal) modal.close();
        });

        modalContinuar.addEventListener('click', () => modal.close());
    }

    // Contador de vigencia: se actualiza cada minuto.
    const formatearRestante = (fin: Date) => {
        const minutos = Math.max(0, Math.floor((fin.getTime() - Date.now()) / 60000));
        const dias = Math.floor(minutos / 1440);
        const horas = Math.floor((minutos % 1440) / 60);
        const mins = minutos % 60;
        return `${dias} d ${String(horas).padStart(2, '0')} h ${String(mins).padStart(2, '0')} m`;
    };

    const actualizarVigencia = () => {
        document.querySelectorAll<HTMLElement>('[data-vence-restante]').forEach((el) => {
            const fin = new Date(el.dataset.venceFin ?? '');
            if (!Number.isNaN(fin.getTime())) el.textContent = formatearRestante(fin);
        });
    };

    actualizarVigencia();
    window.setInterval(actualizarVigencia, 60_000);
</script>
