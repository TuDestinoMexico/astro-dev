---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Content from "../components/layout/Content.astro";

const alianzasExclusivas = [
    {
        empresa: "Sams Club Afiliados",
        tipo: "Afiliación PLUS / Benefits",
        descripcion: "Con tu Membresía física o digital PLUS o Benefits obtén:",
        beneficios: [
            "15% de descuento",
            "Paquetes a costo preferencia por $18,990"
        ],
        url: "https://www.samsbenefits.com/resultados/detalles/Tu-Destino-M%C3%A9xico/P7562",
        monograma: "bg-orange-500",
        etiqueta: "bg-orange-100 text-orange-800"
    },
    {
        empresa: "Nissan",
        tipo: "Colaborador Corporativo",
        descripcion: "Si eres un colaborador de Grupo Nissan, escapate a unas vacaciones en la playa.",
        url: "https://conveniosnissan.com/c/Tu-Destino-Mexico_12668",
        beneficios: [
            "Paquetes en $13,990",
            "35% de descuento en hoteles",
            "25% en tours y traslados"
        ],
        monograma: "bg-red-600",
        etiqueta: "bg-red-50 text-red-700"
    }
].map((aliado) => ({
    ...aliado,
    inicial: aliado.empresa.charAt(0).toUpperCase(),
    // Separa las cifras para resaltarlas sin cambiar el texto.
    beneficiosPartes: aliado.beneficios.map((beneficio) =>
        beneficio
            .split(/(\$?\d[\d,.]*%?)/)
            .filter(Boolean)
            .map((parte) => ({ texto: parte, destacado: /^\$?\d/.test(parte) }))
    ),
}));
---

<Layout title="Convenios Corporativos para Viajes | Tu Destino México" description="Conoce los convenios corporativos y beneficios de viaje disponibles con Tu Destino México para colaboradores y afiliados.">
    <Header/>

    <Content>
        <section class="py-10 md:py-14" aria-labelledby="convenios-titulo">

            <header class="mb-10 max-w-3xl md:mb-12">
                <p class="text-xs font-black uppercase tracking-[0.2em] text-purple-700">Alianzas exclusivas</p>
                <h1 id="convenios-titulo" class="mt-2 text-3xl font-extrabold leading-tight text-purple-800 md:text-4xl">
                    Convenios corporativos para viajes
                </h1>
                <h2 class="mt-2 text-lg font-bold text-slate-700 md:text-xl">Beneficios vigentes</h2>
                <p class="mt-3 text-base leading-relaxed text-slate-500 md:text-lg">
                    Aprovecha los beneficios exclusivos que tenemos para ti a través de nuestras alianzas.
                </p>
            </header>

            <ul class="grid max-w-4xl gap-6 md:grid-cols-2 md:gap-8">
                {alianzasExclusivas.map((aliado) => (
                    <li>
                        <article class="flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 motion-safe:hover:-translate-y-1 hover:shadow-xl md:p-8">

                            <div class="flex items-start gap-4">
                                <span class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-xl font-black text-white ${aliado.monograma}`} aria-hidden="true">
                                    {aliado.inicial}
                                </span>
                                <div class="min-w-0">
                                    <span class={`inline-block rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wider ${aliado.etiqueta}`}>
                                        {aliado.tipo}
                                    </span>
                                    <h3 class="mt-2 text-xl font-bold leading-tight text-slate-900 md:text-2xl">
                                        {aliado.empresa}
                                    </h3>
                                </div>
                            </div>

                            {aliado.descripcion && (
                                <p class="mt-5 text-sm leading-relaxed text-slate-600 md:text-base">
                                    {aliado.descripcion}
                                </p>
                            )}

                            {aliado.beneficiosPartes.length > 0 && (
                                <ul class="mb-8 mt-5 space-y-3">
                                    {aliado.beneficiosPartes.map((partes) => (
                                        <li class="flex items-start gap-3 text-sm text-slate-700 md:text-base">
                                            <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span>
                                                {partes.map((parte) => (
                                                    parte.destacado
                                                        ? <strong class="font-extrabold text-purple-800">{parte.texto}</strong>
                                                        : parte.texto
                                                ))}
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            )}

                            <div class="mt-auto flex flex-col gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:items-center sm:justify-between">
                                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-500">
                                    <svg class="h-4 w-4 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5h14a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2H5a2 2 0 01-2-2v-3a2 2 0 000-4V7a2 2 0 012-2z"></path>
                                    </svg>
                                    Cupón disponible
                                </span>
                                <a
                                    href={aliado.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`Ver beneficio de ${aliado.empresa} (se abre en una pestaña nueva)`}
                                    class="inline-flex min-h-12 w-full items-center justify-center whitespace-nowrap rounded-xl bg-slate-900 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-purple-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600 focus-visible:ring-offset-2 sm:w-auto"
                                >
                                    Ver beneficio
                                </a>
                            </div>
                        </article>
                    </li>
                ))}
            </ul>

        </section>
    </Content>

    <Footer/>
</Layout>
